#!/usr/bin/env python3
"""
openSUSE .spec Conflict Resolver & Git Merge Driver
Runs standard git merge-file on Ours (%A), and then automatically resolves
any 'Version:' line conflicts in favor of Ours (HEAD / next).

Usage as a Git Merge Driver:
  Add the driver definition to your Git config, and assign it to *.spec files 
  using a .gitattributes file.
"""

import os
import sys
import re
import subprocess

def main():
    if len(sys.argv) != 5:
        print("Usage as merge driver: resolve-spec <ancestor_file> <ours_file> <theirs_file> <original_path>", file=sys.stderr)
        sys.exit(1)

    ancestor_file = sys.argv[1]
    ours_file = sys.argv[2]
    theirs_file = sys.argv[3]
    original_path = sys.argv[4]

    print(f"🔄 Git Merge Driver (Spec): Processing {original_path}...", file=sys.stderr)

    # 1. Run git merge-file on Ours (%A) using Ancestor (%O) and Theirs (%B)
    # This does a standard Git merge.
    subprocess.run(
        ['git', 'merge-file', ours_file, ancestor_file, theirs_file],
        capture_output=True
    )

    # 2. Read Ours file which now contains standard merge results (and possibly conflicts)
    try:
        with open(ours_file, 'r', encoding='utf-8') as f:
            content = f.read()
    except Exception as e:
        print(f"❌ Error: Could not read spec merge temp file: {e}", file=sys.stderr)
        sys.exit(1)

    # 3. Automatically resolve 'Version:' line conflicts in favor of Ours (HEAD)
    # Matches:
    # <<<<<<< <anything>
    # [ \t]*Version: <ours_version>
    # =======
    # [ \t]*Version: <theirs_version>
    # >>>>>>> <anything>
    version_conflict_pattern = re.compile(
        r'^<<<<<<< [^\n]*\n'
        r'([ \t]*Version:\s*[^\n]*)\n'
        r'^=======\n'
        r'[ \t]*Version:\s*[^\n]*\n'
        r'^>>>>>>> [^\n]*$',
        re.MULTILINE | re.IGNORECASE
    )

    resolved_content, count = version_conflict_pattern.subn(r'\1', content)
    if count > 0:
        print(f"🕒 Git Merge Driver (Spec): Auto-resolved {count} 'Version:' line conflict(s) in favor of Ours.", file=sys.stderr)

    # 4. Write back resolved content to Ours file
    with open(ours_file, 'w', encoding='utf-8') as f:
        f.write(resolved_content)

    # 5. Check if there are still any other unresolved conflicts in the spec file
    if "<<<<<<< " in resolved_content:
        print(f"⚠️ Git Merge Driver (Spec): Other unresolved conflicts remain in {original_path}. Leaving conflicted.", file=sys.stderr)
        sys.exit(1) # Exit code 1 tells Git there are still conflicts that require manual resolution!
    else:
        print(f"✅ Git Merge Driver (Spec): Successfully merged {original_path} cleanly!", file=sys.stderr)
        sys.exit(0) # Exit code 0 tells Git the file is 100% cleanly merged!

if __name__ == '__main__':
    main()
