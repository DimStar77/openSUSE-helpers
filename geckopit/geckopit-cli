def run_package_upgrade(pkg_dir=".", revision=None, dry_run=False):
    pkg_dir = os.path.abspath(pkg_dir)
    helper = get_upgrade_helper(pkg_dir)
    if not helper:
        print(f"\033[1;31m[Error]\033[0m No compatible upgrade helper detected for directory: {pkg_dir}", file=sys.stderr)
        print("Available engines:")
        for h in list_upgrade_helpers():
            print(f"  • {h.name} - {h.description}")
        return 1

    pkg_name = sb.get_package_name_from_dir(pkg_dir)
    if helper.name == "tarball":
        target_label = "Target Version:"
        rev_display = revision if (revision and revision != "@PARENT_TAG@") else "latest upstream release"
    else:
        target_label = "Target Revision:"
        rev_display = revision if revision else "@PARENT_TAG@ (default)"

    print(f"\033[1;34m=>\033[0m \033[1mGeckopit Package Upgrade\033[0m: \033[1;37m{pkg_name}\033[0m")
    print(f"\033[1;34m=>\033[0m Engine: \033[1;32m{helper.name}\033[0m ({helper.description})")
    print(f"\033[1;34m=>\033[0m {target_label} \033[1;33m{rev_display}\033[0m")
    if dry_run:
        print("\033[1;33m=> Mode: DRY-RUN (no files will be modified)\033[0m")

    result = helper.execute_upgrade(
        target_revision=revision,
        dry_run=dry_run,
        on_log=lambda m: print(f"   \033[0;37m{m}\033[0m")
    )

    print()
    if result.success:
        print(f"\033[1;32m=> Upgrade Succeeded:\033[0m {result.message}")
        if getattr(result, "removed_files", None):
            print("   \033[1mCleaned obsolete files:\033[0m")
            for rf in result.removed_files:
                print(f"     • {rf}")
        if getattr(result, "fixed_meson_drifts", None):
            build_systems = {d.get("build_system") for d in result.fixed_meson_drifts if d.get("build_system")}
            if len(build_systems) == 1:
                bs = list(build_systems)[0]
                sys_label = "CMake" if bs == "cmake" else ("Autotools" if bs == "autotools" else ("Python" if bs == "python" else "Meson"))
            else:
                sys_label = "build"
            print("   \033[1mSynced " + sys_label + " dependencies:\033[0m")
            for fd in result.fixed_meson_drifts:
                decl = fd.get("fixed_declaration") or f"{fd['package']} >= {fd['upstream_version']}"
                print(f"     • {decl}")
        if result.diff_files:
            print("   \033[1mReview files generated:\033[0m")
            for df in result.diff_files.keys():
                print(f"     • {df}")
        if result.has_retrospective_news:
            print("   \033[1;33m⚠️  Notice:\033[0m Upstream NEWS diff contains additions to older release sections. Please inspect 'osc-collab.NEWS' if past .changes entries should be annotated.")
        if getattr(result, "has_obscpio_warning", False):
            print("   \033[1;33m⚠️  Notice:\033[0m Package uses buildtime obscpio in a git-managed repository. Storing .obscpio in Git LFS is discouraged; migrating away from obscpio (e.g. via migrate_service.sh to manual tar.xz) is highly recommended.")

        # Summary badge
        summary_parts = []
        if getattr(result, "old_version", None) and getattr(result, "new_version", None):
            summary_parts.append(f"version {result.old_version} ➔ {result.new_version}")
        elif getattr(result, "new_version", None):
            summary_parts.append(f"version {result.new_version}")

        num_removed = len(getattr(result, "removed_files", []) or [])
        if num_removed > 0:
            summary_parts.append(f"{num_removed} obsolete file{'s' if num_removed != 1 else ''} cleaned")

        num_diffs = len(result.diff_files or {})
        if num_diffs > 0:
            summary_parts.append(f"{num_diffs} review diff{'s' if num_diffs != 1 else ''} generated")
        num_meson_fixed = len(getattr(result, "fixed_meson_drifts", []) or [])
        if num_meson_fixed > 0:
            build_systems = {d.get("build_system") for d in result.fixed_meson_drifts if d.get("build_system")}
            if len(build_systems) == 1:
                bs = list(build_systems)[0]
                sys_label = "CMake" if bs == "cmake" else ("Autotools" if bs == "autotools" else ("Python" if bs == "python" else "Meson"))
            else:
                sys_label = "build"
            summary_parts.append(f"{num_meson_fixed} {sys_label} dep{'s' if num_meson_fixed != 1 else ''} synced")

        if summary_parts:
            print(f"   \033[1;36m✨ Summary:\033[0m {', '.join(summary_parts)}")

        return 0
    else:
        print(f"\033[1;31m=> Upgrade Failed:\033[0m {result.message}", file=sys.stderr)
        return 1


def run_sync_action(target_pkg_dir=None, force=False, jobs=16):
    sync_bin = sb.find_git_project_sync()
    if not sync_bin:
        print(f"\033[1;31m=> Error:\033[0m git-project-sync executable not found in PATH or ~/bin.", file=sys.stderr)
        return 1

    if target_pkg_dir:
        pkg_dir = os.path.abspath(target_pkg_dir)
        pkg_name = sb.get_package_name_from_dir(pkg_dir)
        print(f"\033[1;34m=>\033[0m \033[1mGeckopit Package SCM Sync\033[0m: \033[1;37m{pkg_name}\033[0m")
        print(f"\033[1;34m=>\033[0m Engine: \033[1;32mgit-project-sync\033[0m ({sync_bin})")
        print(f"\033[1;34m=>\033[0m Target: \033[0;37m{pkg_dir}\033[0m")
        if force:
            print("\033[1;33m=> Mode: FORCE AUDIT (-f)\033[0m")
        print()

        ok, updated, failed = sb.run_workspace_sync([pkg_dir], jobs=jobs, force=force, on_log=lambda m: print(f"   {m}"))
        print()
        if ok and not failed:
            print(f"\033[1;32m=> Sync Succeeded:\033[0m Package '{pkg_name}' synchronized with remote tracking.")
            return 0
        else:
            print(f"\033[1;31m=> Sync Warning:\033[0m Synchronization failed or encountered conflicts in '{pkg_name}'.", file=sys.stderr)
            return 1
    else:
        # Workspace-level sync
        targets = []
        if os.path.isfile(".gitmodules") or sb.discover_workspace_packages("."):
            targets = [os.path.abspath(".")]
        else:
            cfg = sb.load_geckopit_profile_config()
            sp = cfg.get("stable_path")
            up = cfg.get("unstable_path")
            for p in (sp, up):
                if p and os.path.isdir(p) and p not in targets:
                    targets.append(os.path.abspath(p))

        if not targets:
            targets = [os.path.abspath(".")]

        print(f"\033[1;34m=>\033[0m \033[1mGeckopit Workspace SCM Sync\033[0m")
        print(f"\033[1;34m=>\033[0m Engine: \033[1;32mgit-project-sync\033[0m ({sync_bin})")
        print(f"\033[1;34m=>\033[0m Targets: \033[0;37m{', '.join(targets)}\033[0m")
        if force:
            print("\033[1;33m=> Mode: FORCE AUDIT (-f)\033[0m")
        print()

        ok, updated, failed = sb.run_workspace_sync(targets, jobs=jobs, force=force, on_log=lambda m: print(f"   {m}"))
        print()
        if ok and not failed:
            summary = []
            if updated:
                summary.append(f"{len(updated)} package{'s' if len(updated) != 1 else ''} updated by bot ({', '.join(updated[:5])}{'...' if len(updated) > 5 else ''})")
            else:
                summary.append("workspace is fully up to date")
            print(f"\033[1;32m=> Sync Succeeded:\033[0m {', '.join(summary)}")
            return 0
        else:
            fail_str = f" ({', '.join(failed)})" if failed else ""
            print(f"\033[1;31m=> Sync Notice:\033[0m Synchronization completed with warnings or conflicts{fail_str}.", file=sys.stderr)
            return 1


