#!/usr/bin/env python3
"""
openSUSE Workspace Downstream Checker CLI
CLI Frontend relying on sync_backend.py, upgrade helpers, and commit_helper.
Supports both Project meta-checkouts and single-package directories with
sync checking, upstream upgrades, and defensive commits.
"""

import os
import sys
import concurrent.futures
import locale
import difflib
import subprocess

# Gracefully handle container environments missing host regional locale files
try:
    locale.setlocale(locale.LC_ALL, '')
except locale.Error:
    os.environ['LC_ALL'] = 'C.UTF-8'

# Make sure we can import helpers by resolving symlinks
HELPERS_DIR = os.path.join(os.path.dirname(os.path.realpath(__file__)), 'helpers')
if HELPERS_DIR not in sys.path:
    sys.path.insert(0, HELPERS_DIR)

import sync_backend as sb
import commit_helper as ch
from upgrade import get_upgrade_helper, list_upgrade_helpers
import meson_drift
import pr_helper
import patch_checker
import pool_submit


def render_single_package_dashboard(data):
    repo = data['repo_name']
    wt = data['worktree']
    sync = data['sync']
    ver = data['version']
    pr = data['pr']
    branch = data['active_branch']

    print(f"{sb.BOLD}{'='*72}{sb.RESET}")
    print(f"📦 {sb.BOLD}GECKOPIT PACKAGE DASHBOARD: {sb.CYAN}{repo}{sb.RESET}")
    print(f"{sb.BOLD}{'='*72}{sb.RESET}")
    print(f"  Directory:     {data['pkg_dir']}")
    is_osc = os.path.isdir(os.path.join(data['pkg_dir'], ".osc")) and not os.path.exists(os.path.join(data['pkg_dir'], ".git"))
    if is_osc:
        print(f"  VCS:           {sb.CYAN}OSC Checkout (.osc){sb.RESET}")
    else:
        upstream_ref = wt.get('upstream') or f"origin/{branch}"
        print(f"  Checked Out:   {sb.BOLD}{branch}{sb.RESET} (tracking {upstream_ref})")
    project = ver.get('project', repo)
    print(f"  Upstream URL:  https://release-monitoring.org/project/{project}/")
    print()

    # Section 1: Local Worktree Status
    print(f"── {sb.BOLD}💻 Local Worktree Status{sb.RESET} {'─'*45}")
    if is_osc:
        print(f"  Working Tree:  {sb.CYAN}OSC checkout (use 'osc status' for local changes){sb.RESET}")
        print()
    else:
        ahead = wt.get('ahead', 0)
        behind = wt.get('behind', 0)
        dirty = wt.get('dirty', False)
        untracked = wt.get('untracked', False)

        if behind > 0 and ahead > 0:
            align_str = f"{sb.RED}❌ Diverged from {upstream_ref} (Behind {behind}, Ahead {ahead}){sb.RESET}"
        elif behind > 0:
            align_str = f"{sb.YELLOW}⚠️ Behind {upstream_ref} by {behind} commit{'s' if behind > 1 else ''} (Pull needed){sb.RESET}"
        elif ahead > 0:
            align_str = f"{sb.CYAN}📤 Ahead of {upstream_ref} by {ahead} commit{'s' if ahead > 1 else ''} (Unpushed){sb.RESET}"
        else:
            align_str = f"{sb.GREEN}✅ Up-to-date with {upstream_ref}{sb.RESET}"
        print(f"  Alignment:     {align_str}")

        if wt.get("has_conflict"):
            tree_str = f"{sb.RED}{sb.BOLD}⚠️  Merge Conflict (unresolved index entries){sb.RESET}"
        elif dirty and untracked:
            tree_str = f"{sb.YELLOW}⚠️ Dirty (uncommitted modifications + untracked files){sb.RESET}"
        elif dirty:
            tree_str = f"{sb.YELLOW}⚠️ Dirty (uncommitted modifications){sb.RESET}"
        elif untracked:
            tree_str = f"{sb.YELLOW}⚠️ Untracked files present{sb.RESET}"
        else:
            tree_str = f"{sb.GREEN}✅ Clean working directory{sb.RESET}"
        print(f"  Working Tree:  {tree_str}")
        print()

    # Section 2: Downstream SCM Sync (Gitea & Pool)
    if not is_osc:
        print(f"── {sb.BOLD}🔄 Downstream SCM Sync (Gitea & Pool){sb.RESET} {'─'*32}")
        st_branch = data.get('stable_branch', 'factory')
        unst_branch = data.get('unstable_branch', 'next')
        head = wt.get('head') or branch
        next_ahead = sync.get('next_ahead', 0)
        next_behind = sync.get('next_behind', 0)
        next_status = sync.get('next_status', 'unknown')

        if head not in (st_branch, unst_branch):
            stream_info = pool_submit.check_pool_stream_sync(data.get('pkg_dir', '.'), branch=head, pkg_name=repo)
            if stream_info.get("exists"):
                s_ahead = stream_info.get("ahead", 0)
                s_behind = stream_info.get("behind", 0)
                if s_ahead > 0 and s_behind > 0:
                    b_s = 's' if s_behind != 1 else ''
                    a_s = 's' if s_ahead != 1 else ''
                    pool_str = f"{sb.RED}❌ Diverged from central pool ({head}) (Behind {s_behind}{b_s}, Ahead {s_ahead}{a_s}){sb.RESET}"
                elif s_behind > 0:
                    b_s = 's' if s_behind != 1 else ''
                    pool_str = f"{sb.YELLOW}📥 Behind central pool ({head}) by {s_behind} commit{b_s} (Pull needed){sb.RESET}"
                elif s_ahead > 0:
                    a_s = 's' if s_ahead != 1 else ''
                    pool_str = f"{sb.CYAN}📤 Ahead of central pool ({head}) by {s_ahead} commit{a_s} (PR needed){sb.RESET}"
                else:
                    pool_str = f"{sb.GREEN}✅ In Sync with central pool ({head}){sb.RESET}"
                print(f"  Gitea Pool:    {pool_str}")
                print(f"  Branch Sync:   — (Tracking release stream '{head}')")
                print()
            else:
                cand_prj = pool_submit.get_git_obs_meta_project(data.get('pkg_dir'), branch=head)
                if cand_prj:
                    pool_str = f"{sb.CYAN}ℹ️ Configured for {cand_prj} via git-obs{sb.RESET}"
                else:
                    pool_str = f"{sb.YELLOW}⚠️ Checked out on '{head}' (not tracked in central pool){sb.RESET}"
                print(f"  Gitea Pool:    {pool_str}")
                print(f"  Branch Sync:   — (Central pool tracks '{st_branch}')")
                print()
        else:
            pool_behind = sync.get('pool_behind', 0)
            pool_ahead = sync.get('pool_ahead', 0)
            pool_status = sync.get('pool_status', 'unknown')
            if pool_behind > 0 and pool_ahead > 0:
                b_s = 's' if pool_behind != 1 else ''
                a_s = 's' if pool_ahead != 1 else ''
                pool_str = f"{sb.RED}❌ Diverged (Behind {pool_behind} commit{b_s}, Ahead {pool_ahead} commit{a_s}){sb.RESET}"
            elif pool_behind > 0:
                b_s = 's' if pool_behind != 1 else ''
                pool_str = f"{sb.YELLOW}📥 Behind central pool by {pool_behind} commit{b_s} (Pull needed){sb.RESET}"
            elif pool_ahead > 0:
                a_s = 's' if pool_ahead != 1 else ''
                pool_sub = pool_submit.get_package_pool_submission_status(
                    repo,
                    target_project="openSUSE:Factory",
                    pkg_dir=data.get('pkg_dir'),
                    stable_branch=data.get('stable_branch', 'factory')
                )
                if pool_sub["status"] == "pending_outdated":
                    req = pool_sub["request"]
                    pool_str = f"{sb.CYAN}📤 Pending SR #{req['id']} is outdated (Newer changes in {req.get('source_project')}; supersede ready){sb.RESET}"
                elif pool_sub["status"] == "pending":
                    req = pool_sub["request"]
                    pool_str = f"{sb.YELLOW}⏳ Pending SR #{req['id']} ({req['state']} from {req.get('source_project')}){sb.RESET}"
                elif pool_sub["status"] == "accepted_pending_sync":
                    req = pool_sub["request"]
                    pool_str = f"{sb.GREEN}⏳ SR #{req['id']} accepted (awaiting central pool sync){sb.RESET}"
                else:
                    pool_str = f"{sb.CYAN}📤 Ahead of central pool by {pool_ahead} commit{a_s} (Submit needed){sb.RESET}"
            elif pool_status == 'Not in Pool':
                pool_str = f"{sb.YELLOW}❓ Not in Pool{sb.RESET}"
            elif pool_status in ('Fetch failed', 'Error', 'unknown'):
                pool_str = f"{sb.RED}⚠️ Failed to fetch pool ({pool_status}){sb.RESET}"
            elif pool_status == 'In Sync':
                pool_str = f"{sb.GREEN}✅ In Sync with pool{sb.RESET}"
            else:
                pool_str = f"{sb.YELLOW}❓ {pool_status}{sb.RESET}"
            print(f"  Gitea Pool:    {pool_str}")

            next_ahead = sync.get('next_ahead', 0)
            next_behind = sync.get('next_behind', 0)
            next_status = sync.get('next_status', 'unknown')
            if next_status == 'No next branch':
                fwd_str = '— (No unstable branch configured)'
            elif next_status in ('Comparison failed', 'Error', 'unknown'):
                fwd_str = f"{sb.RED}⚠️ Branch comparison failed ({next_status}){sb.RESET}"
            elif next_behind > 0 and next_ahead > 0:
                b_s = 's' if next_behind != 1 else ''
                a_s = 's' if next_ahead != 1 else ''
                fwd_str = f"{sb.RED}❌ Diverged (Behind {next_behind} commit{b_s}, Ahead {next_ahead} commit{a_s}){sb.RESET}"
            elif next_behind > 0:
                b_s = 's' if next_behind != 1 else ''
                fwd_str = f"{sb.YELLOW}⚠️ Behind {st_branch} by {next_behind} commit{b_s} (Catch-up merge needed){sb.RESET}"
            elif next_ahead > 0:
                a_s = 's' if next_ahead != 1 else ''
                if pr.get('has_forward_pr'):
                    fwd_num = pr.get('number')
                    pr_ref = f"PR #{fwd_num} pending" if fwd_num else "PR pending"
                    fwd_str = f"{sb.GREEN}🔀 Ahead of {st_branch} by {next_ahead} commit{a_s} ({pr_ref}){sb.RESET}"
                else:
                    fwd_str = f"{sb.GREEN}🔀 Ahead of {st_branch} by {next_ahead} commit{a_s} (Ready for PR){sb.RESET}"
            elif ahead > 0:
                fwd_str = f"{sb.GREEN}✅ In Sync on remote{sb.RESET} {sb.CYAN}(local branch carries {ahead} unpushed commit{'s' if ahead > 1 else ''}){sb.RESET}"
            elif next_status in ('In Sync', 'Ahead (ok)'):
                fwd_str = f"{sb.GREEN}✅ In Sync{sb.RESET}"
            else:
                fwd_str = f"{sb.YELLOW}❓ {next_status}{sb.RESET}"
            print(f"  Branch Sync:   {fwd_str}")
            print()

        if pr.get('has_pr', False):
            prs = pr.get('prs', [])
            count = pr.get('count', len(prs)) or len(prs) or 1
            if count == 1:
                p = prs[0] if prs else {
                    'number': pr.get('number'),
                    'title': pr.get('title') or 'Pull Request',
                    'url': pr.get('url'),
                    'author': 'contributor',
                    'base': st_branch,
                    'is_forward': pr.get('has_forward_pr', False)
                }
                fwd_tag = f" {sb.GREEN}[Forward]{sb.RESET}" if p.get('is_forward') else ""
                p_title = p.get('title', '')
                p_author = p.get('author', 'unknown')
                p_base = p.get('base', st_branch)
                p_num = p.get('number') or pr.get('number')
                p_url = p.get('url') or pr.get('url')
                print(f"  Active PR:     {sb.GREEN}🟢 PR #{p_num}{sb.RESET} by @{p_author}: \"{p_title}\" (➔ {p_base}){fwd_tag}")
                if p_url:
                    print(f"                    {p_url}")
            else:
                print(f"  Active PR:     {sb.GREEN}🟢 {count} Active PRs:{sb.RESET}")
                for p in prs:
                    fwd_tag = f" {sb.GREEN}[Forward]{sb.RESET}" if p.get('is_forward') else ""
                    p_title = p.get('title', '')
                    p_url = p.get('url', '')
                    print(f"                 • PR #{p['number']} by @{p['author']}: \"{p_title}\" (➔ {p['base']}){fwd_tag}")
                    if p_url:
                        print(f"                   {p_url}")
        print()

    # Section 3: Upstream Release Versions
    print(f"── {sb.BOLD}📦 Upstream Release Versions{sb.RESET} {'─'*41}")
    f_ver = ver.get('factory_ver', 'N/A')
    u_stable = ver.get('upstream_stable', 'N/A')
    n_ver = ver.get('next_ver', '—')
    u_latest = ver.get('upstream_latest', '—')

    if sb.is_version_newer(u_stable, f_ver, repo):
        f_status = f"{sb.YELLOW}🔺 Update available: {f_ver} ➔ {u_stable}{sb.RESET}"
    else:
        f_status = f"{sb.GREEN}✅ Up-to-date ({f_ver}){sb.RESET}"
    print(f"  Stable:        {f_status}")

    if n_ver != '—':
        if sb.is_version_newer(u_latest, n_ver, repo):
            n_status = f"{sb.YELLOW}🔺 Update available: {n_ver} ➔ {u_latest}{sb.RESET}"
        else:
            n_status = f"{sb.GREEN}✅ Up-to-date ({n_ver}){sb.RESET}"
        print(f"  Unstable:      {n_status}")
    print()

    # Section 4: Recommended Actions
    actions = []
    if is_osc:
        if ver.get('needs_update'):
            target_v = u_stable
            p_dir = data.get('pkg_dir', '.')
            h_cand = get_upgrade_helper(p_dir)
            if h_cand and h_cand.name == "obs_scm":
                cur_rev = h_cand.get_current_revision(p_dir)
                guessed, err = sb.guess_update_revision(cur_rev, target_v)
                if guessed and not err:
                    target_v = guessed
            actions.append(f"⚙️  Run package upgrade: {sb.BOLD}geckopit-cli --upgrade {target_v}{sb.RESET}")
        actions.append(f"📦 Check OSC status: {sb.BOLD}osc status{sb.RESET}")
        actions.append(f"💾 Submit changes: {sb.BOLD}osc ci{sb.RESET}")
    else:
        if behind > 0:
            actions.append(f"📥 Pull remote commits: {sb.BOLD}git pull --ff-only{sb.RESET}")
        if ahead > 0:
            actions.append(f"📤 Push local commits to remote: {sb.BOLD}git push origin {branch}{sb.RESET}")
        if dirty:
            actions.append(f"💾 Commit package changes: {sb.BOLD}geckopit-cli --commit{sb.RESET}")
        if wt.get("has_conflict"):
            actions.append(f"⚠️  Resolve merge conflicts in working tree: {sb.BOLD}git status / git mergetool{sb.RESET}")
        elif behind > 0:
            actions.append(f"🔄 Fast-forward from remote: {sb.BOLD}geckopit-cli --sync{sb.RESET}")
        head = wt.get('head') or branch
        if head not in (st_branch, unst_branch):
            stream_info = pool_submit.check_pool_stream_sync(data.get('pkg_dir', '.'), branch=head, pkg_name=repo)
            if stream_info.get("exists"):
                s_ahead = stream_info.get("ahead", 0)
                s_behind = stream_info.get("behind", 0)
                if s_behind > 0:
                    actions.append(f"📥 Pull upstream changes from central pool ({head}): {sb.BOLD}git pull https://src.opensuse.org/pool/{repo}.git {head}{sb.RESET}")
                if s_ahead > 0:
                    actions.append(f"📤 Create Gitea Pull Request to central pool ({head}): {sb.BOLD}https://src.opensuse.org/pool/{repo}/pulls{sb.RESET}")
            else:
                cand_prj = pool_submit.get_git_obs_meta_project(data.get('pkg_dir'), branch=head)
                if not cand_prj:
                    actions.append(f"ℹ️  Current branch '{head}' has no OBS submission target. Switch to '{st_branch}' to submit to openSUSE:Factory: {sb.BOLD}git checkout {st_branch}{sb.RESET}")
        else:
            if pool_behind > 0:
                actions.append(f"📥 Pull upstream changes from Pool: {sb.BOLD}git fetch https://src.opensuse.org/pool/{repo}.git factory && git merge FETCH_HEAD{sb.RESET}")
            if pool_ahead > 0:
                pool_sub = pool_submit.get_package_pool_submission_status(
                    repo,
                    target_project="openSUSE:Factory",
                    pkg_dir=data.get('pkg_dir'),
                    stable_branch=data.get('stable_branch', 'factory')
                )
                if pool_sub["status"] == "pending_outdated":
                    req = pool_sub["request"]
                    actions.append(f"📤 Supersede pending SR #{req['id']} with latest sources: {sb.BOLD}geckopit-cli --submit-pool{sb.RESET}")
                elif pool_sub["status"] == "pending":
                    req = pool_sub["request"]
                    actions.append(f"⏳ Wait for pending SR #{req['id']} ({req['state']}) to merge in openSUSE:Factory")
                elif pool_sub["status"] == "accepted_pending_sync":
                    req = pool_sub["request"]
                    actions.append(f"⏳ Wait for accepted SR #{req['id']} to sync into central pool")
                else:
                    actions.append(f"📤 Submit changes to central pool (openSUSE:Factory): {sb.BOLD}geckopit-cli --submit-pool{sb.RESET}")
        if head in (st_branch, unst_branch):
            if next_behind > 0:
                actions.append(f"🔀 Catch-up merge from {st_branch}: {sb.BOLD}git merge origin/{st_branch}{sb.RESET}")
            # Only recommend PR if commits are actually on remote (ahead == 0) and not in active PR
            if ahead == 0 and next_ahead > 0 and not pr.get('has_forward_pr'):
                actions.append(f"📤 Create Gitea Pull Request from {branch} to {st_branch}")
        if ver.get('needs_update'):
            target_v = u_latest if branch == 'next' and u_latest != '—' else u_stable
            p_dir = data.get('pkg_dir', '.')
            h_cand = get_upgrade_helper(p_dir)
            if h_cand and h_cand.name == "obs_scm":
                cur_rev = h_cand.get_current_revision(p_dir)
                guessed, err = sb.guess_update_revision(cur_rev, target_v)
                if guessed and not err:
                    target_v = guessed
            # Highlight existing PRs from contributors for this upgrade
            if pr.get('has_pr'):
                matching_prs = [p for p in pr.get('prs', []) if not p.get('is_forward')]
                if matching_prs:
                    for p in matching_prs:
                        p_title = p.get("title", "")
                        actions.append(f"📥 Merge contributor PR #{p['number']} by @{p['author']}: {sb.BOLD}geckopit-cli --merge-pr {p['number']}{sb.RESET} (\"{p_title}\")")
            actions.append(f"⚙️  Run package upgrade: {sb.BOLD}geckopit-cli --upgrade {target_v}{sb.RESET}")
        try:
            p_dir = data.get('pkg_dir', '.')
            h_cand = get_upgrade_helper(p_dir)
            if h_cand and getattr(h_cand, "uses_obscpio", None) and h_cand.uses_obscpio():
                actions.append(f"⚠️  Migrate away from .obscpio (storing .obscpio in Git LFS is discouraged; migration to manual tar.xz highly recommended)")
        except Exception:
            pass

        try:
            p_dir = data.get('pkg_dir', '.')
            drifts = meson_drift.audit_meson_drift(p_dir)
            if drifts:
                d_summary = meson_drift.format_drift_short_summary(drifts)
                actions.append(f"{sb.YELLOW}{d_summary}{sb.RESET} (run {sb.BOLD}geckopit-cli --audit-deps{sb.RESET} for details)")
        except Exception:
            pass

    print(f"── {sb.BOLD}💡 Recommended Actions{sb.RESET} {'─'*46}")
    if actions:
        for a in actions:
            print(f"  • {a}")
    else:
        print(f"  {sb.GREEN}✅ Package is fully in sync and up-to-date. No action needed!{sb.RESET}")
    print(f"{sb.BOLD}{'='*72}{sb.RESET}")


def run_single_package_dashboard(pkg_dir="."):
    pkg_name = sb.get_package_name_from_dir(pkg_dir)
    print(f"Inspecting package '{pkg_name}'...", file=sys.stderr)
    data = sb.check_single_package_full(pkg_dir)
    render_single_package_dashboard(data)


def run_single_package_version(pkg_dir=".", branch=None):
    pkg_name = sb.get_package_name_from_dir(pkg_dir)
    print(f"Checking upstream versions for '{pkg_name}'...", file=sys.stderr)
    parent_dir = os.path.dirname(os.path.abspath(pkg_dir))
    prof = sb.load_geckopit_profile_config()
    st_b = prof.get("stable_branch", "factory") or "factory"
    unst_b = prof.get("unstable_branch", "next") or "next"
    ignored = prof.get("ignored_unstable_versions", {})

    _, data = sb.check_repo_version(pkg_name, branch, st_b, unst_b, parent_dir, ignored)
    print(f"\n📦 {sb.BOLD}Package Upstream Version: {sb.CYAN}{pkg_name}{sb.RESET}")
    print(f"{sb.BOLD}{'='*60}{sb.RESET}")
    f_ver = data.get("factory_ver", "N/A")
    u_stable = data.get("upstream_stable", "N/A")
    n_ver = data.get("next_ver", "—")
    u_latest = data.get("upstream_latest", "—")

    if not branch or branch == "factory":
        if sb.is_version_newer(u_stable, f_ver, pkg_name):
            status = f"{sb.YELLOW}🔺 Update available: {f_ver} ➔ {u_stable}{sb.RESET}"
        else:
            status = f"{sb.GREEN}✅ Up-to-date ({f_ver}){sb.RESET}"
        print(f"  Stable:        {status}")

    if not branch or branch == unst_b:
        if n_ver != "—":
            if sb.is_version_newer(u_latest, n_ver, pkg_name):
                status = f"{sb.YELLOW}🔺 Update available: {n_ver} ➔ {u_latest}{sb.RESET}"
            else:
                status = f"{sb.GREEN}✅ Up-to-date ({n_ver}){sb.RESET}"
            print(f"  Unstable:      {status}")
    print(f"{sb.BOLD}{'='*60}{sb.RESET}")


def run_single_package_forward(pkg_dir=".", show_pr=False, only_no_pr=False):
    pkg_name = sb.get_package_name_from_dir(pkg_dir)
    print(f"Checking forwarding status for '{pkg_name}'...", file=sys.stderr)
    parent_dir = os.path.dirname(os.path.abspath(pkg_dir))
    prof = sb.load_geckopit_profile_config()
    st_b = prof.get("stable_branch", "factory") or "factory"
    unst_b = prof.get("unstable_branch", "next") or "next"

    _, sync = sb.check_repo_sync(pkg_name, st_b, unst_b, parent_dir)
    _, pr = sb.check_repo_pr(pkg_name, st_b, unst_b, parent_dir)

    print(f"\n🔀 {sb.BOLD}Package Forwarding State: {sb.CYAN}{pkg_name}{sb.RESET}")
    print(f"{sb.BOLD}{'='*60}{sb.RESET}")
    next_ahead = sync.get("next_ahead", 0)
    next_behind = sync.get("next_behind", 0)

    print(f"  Commits Ahead (on next):    {sb.GREEN}{next_ahead}{sb.RESET}")
    print(f"  Commits Behind (factory):   {sb.RED if next_behind > 0 else sb.GREEN}{next_behind}{sb.RESET}")

    if next_behind > 0:
        b_s = 's' if next_behind != 1 else ''
        fwd = f"{sb.YELLOW}⚠️ Needs Catch-up Merge first ({next_behind} commit{b_s} behind){sb.RESET}"
    elif next_ahead > 0:
        a_s = 's' if next_ahead != 1 else ''
        if pr.get('has_forward_pr'):
            fwd_num = pr.get('number')
            pr_ref = f"PR #{fwd_num} pending" if fwd_num else "PR pending"
            fwd = f"{sb.GREEN}🔀 Ahead of {st_branch} by {next_ahead} commit{a_s} ({pr_ref}){sb.RESET}"
        else:
            fwd = f"{sb.GREEN}✅ Ready to Forward (Clean, {next_ahead} commit{a_s} ahead){sb.RESET}"
    else:
        fwd = f"{sb.GREEN}✅ In Sync{sb.RESET}"
    print(f"  Forward Status:             {fwd}")

    if pr.get('has_pr'):
        prs = pr.get('prs', [])
        count = pr.get('count', len(prs)) or len(prs) or 1
        if count == 1:
            p = prs[0] if prs else {
                'number': pr.get('number'),
