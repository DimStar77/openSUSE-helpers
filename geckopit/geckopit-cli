    if os.path.exists(os.path.join(target_pkg_dir, ".git")):
        try:
            res_br = subprocess.run(["git", "-C", target_pkg_dir, "rev-parse", "--abbrev-ref", "HEAD"], capture_output=True, text=True)
            if res_br.returncode == 0 and res_br.stdout.strip():
