    print(f"  {sb.BOLD}-n, --dry-run{sb.RESET}      Used with --upgrade to simulate steps without modifying files.")
    print(f"  {sb.BOLD}-p, --pr{sb.RESET}           Include Gitea pull request pending status in forwarding mode.")
    print(f"  {sb.BOLD}--no-pr{sb.RESET}            In forwarding mode, only show packages without a pending pull request.")
    print(f"  {sb.BOLD}-b, --branch <b>{sb.RESET}   Limit version checks to a specific branch ('factory' or 'next').")
    print(f"  {sb.BOLD}-h, --help{sb.RESET}         Show this help message and exit.")


def main():
    if "-h" in sys.argv or "--help" in sys.argv:
        print_help()
        sys.exit(0)

    # Parse upgrade options first to separate version parameters from target directories
    show_upgrade = False
    upgrade_rev = None
    for idx, arg in enumerate(sys.argv):
        if arg in ("--upgrade", "-u"):
            show_upgrade = True
            if idx + 1 < len(sys.argv) and not sys.argv[idx + 1].startswith("-"):
                upgrade_rev = sys.argv[idx + 1]
        elif arg.startswith("--upgrade="):
            show_upgrade = True
            upgrade_rev = arg.split("=", 1)[1]

    # Detect if a target package argument was provided (e.g. 'geckopit-cli baobab')
    target_arg = None
    for arg in sys.argv[1:]:
        if not arg.startswith("-") and arg != upgrade_rev and arg not in ("factory", "next", "stable", "unstable"):
            target_arg = arg
            break

    # Determine if we are operating in Single-Package context
    target_pkg_dir = None
    if sb.is_package_dir("."):
        target_pkg_dir = "."
    elif target_arg and sb.is_package_dir(target_arg):
        target_pkg_dir = target_arg

    # Parse commit options
    show_commit = "--commit" in sys.argv or "-c" in sys.argv
    no_edit = "--no-edit" in sys.argv

    dry_run = "--dry-run" in sys.argv or "-n" in sys.argv

    # Execute commit mode
    if show_commit:
        if not target_pkg_dir:
            print(f"{sb.RED}[Error]{sb.RESET} --commit must be run inside a package directory (or target a package).", file=sys.stderr)
            sys.exit(1)
        sys.exit(run_package_commit(target_pkg_dir, interactive=not no_edit))

    # Execute upgrade mode
    if show_upgrade:
        if not target_pkg_dir:
            print(f"{sb.RED}[Error]{sb.RESET} --upgrade must be run inside a package directory (or target a package).", file=sys.stderr)
            sys.exit(1)
        sys.exit(run_package_upgrade(target_pkg_dir, revision=upgrade_rev, dry_run=dry_run))

    show_versions = False
    version_branch = None

    # Check for --version or -v with equal sign, e.g. --version=next
    for arg in sys.argv:
        if arg.startswith("--version=") or arg.startswith("-v="):
            show_versions = True
            val = arg.split("=", 1)[1].lower()
            if val in ("next", "factory"):
                version_branch = val

    # Check for standalone --version or -v
    if not show_versions:
        if "--version" in sys.argv or "-v" in sys.argv:
            show_versions = True

    # Check for --branch or -b
    for opt in ("--branch", "-b"):
        if opt in sys.argv:
            idx = sys.argv.index(opt)
            if idx + 1 < len(sys.argv):
                val = sys.argv[idx + 1].lower()
                if val in ("next", "factory"):
                    version_branch = val

    # Check if 'next' or 'factory' is in sys.argv directly following -v/--version
    if show_versions and not version_branch:
        for opt in ("--version", "-v"):
            if opt in sys.argv:
                idx = sys.argv.index(opt)
                if idx + 1 < len(sys.argv):
                    val = sys.argv[idx + 1].lower()
                    if val in ("next", "factory"):
                        version_branch = val

    show_forward = "--forward" in sys.argv or "-f" in sys.argv
    show_todo = "--todo" in sys.argv
    show_no_pr = "--no-pr" in sys.argv
    show_pr = "--pr" in sys.argv or "-p" in sys.argv

    # Route to single-package dashboard if operating in a package directory
    if target_pkg_dir:
        if show_versions:
            run_single_package_version(target_pkg_dir, version_branch)
        elif show_forward:
            run_single_package_forward(target_pkg_dir, show_pr, show_no_pr)
        else:
            run_single_package_dashboard(target_pkg_dir)
        sys.stdout.flush()
        sys.stderr.flush()
        return

    # Operating in Project Directory (Multi-Package batch mode)
    repos = sorted([
        d for d in os.listdir('.')
        if os.path.isdir(d) and os.path.exists(os.path.join(d, '.git'))
    ])

    if show_versions:
        run_version_check(repos, version_branch)
    elif show_forward:
        run_forward_check(repos, show_pr, show_no_pr)
    else:
        run_sync_check(repos)

    sys.stdout.flush()
    sys.stderr.flush()

if __name__ == '__main__':
    try:
        main()
    except BrokenPipeError:
        import os
        os._exit(0)
