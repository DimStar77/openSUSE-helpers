            print(f"  {sb.RED}✗ Failed: {msg}{sb.RESET}")

    print("")
    print(f"Completed: {success_count}/{len(unsubmitted)} packages submitted successfully.")
    return 0 if success_count == len(unsubmitted) else 1


KNOWN_OPTIONS = {
    "--sync", "-s", "--fetch", "--force", "-f",
    "--forward",
    "--version", "-v",
    "--not-in-pool", "--no-pool", "--include-not-in-pool",
    "--todo",
    "--upgrade", "-u",
    "--check-patches", "--verbose", "--sle",
    "--rebase-patch", "--shell",
    "--commit", "-c", "--no-edit",
    "--audit-deps", "-d", "--fix-deps",
    "--list-prs", "--merge-pr", "--squash", "--no-commit",
    "--submit-pool", "--check-pool", "--pending-sr", "--pending-requests",
    "--message", "-m", "--all", "-a", "--yes", "-y",
    "--check-setup", "--setup",
    "--guide", "--docs",
    "--bash-completion",
    "--dry-run", "-n",
    "--pr", "-p", "--no-pr",
    "--branch", "-b",
    "--jobs", "-j",
    "--profile", "--package",
    "--help", "-h"
}


def validate_cli_options(args):
    """
    Validates all command-line options starting with '-' against recognized flags.
    Returns None if all options are recognized, or an error message string if an invalid option is found.
    """
    for arg in args:
        if arg.startswith("-"):
            base_opt = arg.split("=")[0]
            if base_opt not in KNOWN_OPTIONS:
                hint = ""
                # Prefix matching for typos like --c -> --commit
                prefix_candidates = [o for o in sorted(KNOWN_OPTIONS) if o.startswith(base_opt) and len(base_opt) >= 2]
                if prefix_candidates:
                    if len(prefix_candidates) == 1:
                        hint = f" Did you mean '{prefix_candidates[0]}'?"
                    else:
                        opts_str = " or ".join(f"'{c}'" for c in prefix_candidates[:5])
                        hint = f" Did you mean {opts_str}?"
                else:
                    close = difflib.get_close_matches(base_opt, list(KNOWN_OPTIONS), n=1, cutoff=0.5)
                    if close:
                        hint = f" Did you mean '{close[0]}'?"
                return f"[Error] Unrecognized option '{arg}'.{hint}\nSee 'geckopit-cli --help' for available options."
    return None


