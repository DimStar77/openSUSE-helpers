    print("Supports both Project meta-checkouts and single-package directories.")
    print("\nUsage:")
    print("  geckopit-cli [package] [options]")
    print("\nModes:")
    print(f"  {sb.BOLD}(default){sb.RESET}          Checks sync status (or displays comprehensive single-package dashboard).")
    print(f"  {sb.BOLD}-u, --upgrade [REV]{sb.RESET}")
