    print(f"  {sb.BOLD}(default){sb.RESET}          Checks sync status (or displays comprehensive single-package dashboard).")
    print(f"  {sb.BOLD}--todo{sb.RESET}             Alias for the default sync checking mode.")
    print(f"  {sb.BOLD}--version, -v [branch]{sb.RESET}")
    print("                     Compares package versions against release-monitoring.org.")
    print("                     Optional branch: 'factory' or 'next' to filter output.")
    print(f"  {sb.BOLD}--forward, -f{sb.RESET}      Identifies forwardable next branches.")
