def resolve_pool_workspace_context(target_pkg_dir=None, workspace_path="."):
    """
    Detects if the user is operating within an unstable worktree (e.g. GNOME:Next on 'next').
    Since submissions to openSUSE:Factory must track the stable branch ('factory' / GNOME:Factory),
    this helper routes to the configured stable workspace checkout and notifies the user.
    """
    cfg = sb.load_geckopit_profile_config()
    unstable_path = cfg.get("unstable_path")
    stable_path = cfg.get("stable_path")
    if not unstable_path or not stable_path:
        return target_pkg_dir, workspace_path, False

    u_abs = os.path.abspath(unstable_path)
    s_abs = os.path.abspath(stable_path)

    # 1. Package-specific context
    if target_pkg_dir:
        pkg_abs = os.path.abspath(target_pkg_dir)
        try:
            if os.path.commonpath([pkg_abs, u_abs]) == u_abs:
                rel = os.path.relpath(pkg_abs, u_abs)
                cand_stable = os.path.join(s_abs, rel)
                if os.path.exists(cand_stable):
                    return cand_stable, s_abs, True
                else:
                    return pkg_abs, s_abs, False
        except Exception:
            pass
        return target_pkg_dir, workspace_path, False

    # 2. Workspace-wide context
    ws_abs = os.path.abspath(workspace_path)
    try:
        if os.path.commonpath([ws_abs, u_abs]) == u_abs:
            return None, s_abs, True
    except Exception:
        pass

    return target_pkg_dir, workspace_path, False


