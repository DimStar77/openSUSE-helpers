def run_not_in_pool_check(repos):
    total = len(repos)
    print(f"Checking {total} packages for Gitea pool presence (16 threads)...", file=sys.stderr)
    results = {}
    with concurrent.futures.ThreadPoolExecutor(max_workers=16) as executor:
        futures = {executor.submit(sb.check_repo_sync, repo): repo for repo in repos}
        completed = 0
        for future in concurrent.futures.as_completed(futures):
            repo_name, data = future.result()
            results[repo_name] = data
            completed += 1
            if completed % 50 == 0 or completed == total:
                print(f"Progress: {completed}/{total} checked...", end='\r', file=sys.stderr)
    print("", file=sys.stderr)

    not_in_pool = [
        repo for repo in sorted(results.keys())
        if results[repo].get("status") == "success" and results[repo].get("pool_status") == "Not in Pool"
    ]

    if not not_in_pool:
        print(f"\n{sb.GREEN}✅ All {total} checked packages exist in the central Gitea pool.{sb.RESET}\n")
        return

    headers = [
        "Package",
        "Pool Status",
        "Stage 2: Next Branch Status"
    ]
    rows = []
    for repo in not_in_pool:
        d = results[repo]
        next_st = d.get("next_status", "—")
        if next_st == "In Sync":
            next_disp = f"{sb.GREEN}✅ In Sync{sb.RESET}"
        elif next_st == "No next branch":
            next_disp = "—"
        elif d.get("next_behind", 0) > 0 and d.get("next_ahead", 0) > 0:
            next_disp = f"{sb.RED}❌ Diverged (Behind {d['next_behind']}, Ahead {d['next_ahead']}){sb.RESET}"
        elif d.get("next_behind", 0) > 0:
            next_disp = f"{sb.RED}📥 Behind by {d['next_behind']} (needs merge){sb.RESET}"
        elif d.get("next_ahead", 0) > 0:
            c_s = 's' if d.get('next_ahead', 0) != 1 else ''
            next_disp = f"{sb.GREEN}✅ In Sync (+{d['next_ahead']} next commit{c_s}){sb.RESET}"
        else:
            next_disp = next_st

        rows.append((repo, f"{sb.YELLOW}❓ Not in Pool{sb.RESET}", next_disp))

    w1 = max(sb.visual_len(headers[0]), max(sb.visual_len(r[0]) for r in rows))
    w2 = max(sb.visual_len(headers[1]), max(sb.visual_len(r[1]) for r in rows))
    w3 = max(sb.visual_len(headers[2]), max(sb.visual_len(r[2]) for r in rows))

    print(f"\n### ❓ Packages Not in Gitea Pool ({len(not_in_pool)} of {total} packages)\n")
    print(f"| {sb.pad_left(headers[0], w1)} | {sb.pad_left(headers[1], w2)} | {sb.pad_left(headers[2], w3)} |")
    print(f"| {'-'*w1} | {'-'*w2} | {'-'*w3} |")
    for r in rows:
        print(f"| {sb.pad_left(r[0], w1)} | {sb.pad_left(r[1], w2)} | {sb.pad_left(r[2], w3)} |")
    print(f"\n*Total packages not in pool: {len(not_in_pool)}*")


def run_sync_check(repos, include_not_in_pool=False):
    total = len(repos)
    print(f"Checking {total} packages in parallel (16 threads)...", file=sys.stderr)

    results = {}
    with concurrent.futures.ThreadPoolExecutor(max_workers=16) as executor:
        futures = {executor.submit(sb.check_repo_sync, repo): repo for repo in repos}
        completed = 0
        for future in concurrent.futures.as_completed(futures):
            repo_name, data = future.result()
            results[repo_name] = data
            completed += 1
            if completed % 50 == 0 or completed == total:
                print(f"Progress: {completed}/{total} checked...", end='\r', file=sys.stderr)
    print("", file=sys.stderr)

    has_next_count = sum(1 for r, d in results.items() if d.get("status") == "success" and d.get("next_status") != "No next branch")
    not_in_pool_count = sum(1 for d in results.values() if d.get("status") == "success" and d.get("pool_status") == "Not in Pool")

    pending_obs = pool_submit.get_pending_obs_requests("openSUSE:Factory")
    accepted_obs = pool_submit.get_recently_accepted_obs_requests("openSUSE:Factory")

    rows = []
    for repo in sorted(results.keys()):
        data = results[repo]
        if data["status"] != "success":
            continue
        is_actionable = data["needs_action"] or (include_not_in_pool and data.get("pool_status") == "Not in Pool")
        if is_actionable:
            pool_sub = {"status": "none"}
            if data["pool_ahead"] > 0:
                pool_sub = pool_submit.get_package_pool_submission_status(
                    repo,
                    target_project="openSUSE:Factory",
                    pending_requests=pending_obs,
                    accepted_requests=accepted_obs,
                    pkg_dir=data.get('pkg_dir'),
                    stable_branch=data.get('stable_branch', 'factory')
                )

            if data["pool_behind"] > 0 and data["pool_ahead"] > 0:
                stage1_str = f"{sb.RED}❌ Diverged (Behind {data['pool_behind']}, Ahead {data['pool_ahead']}){sb.RESET}"
            elif data["pool_behind"] > 0:
                stage1_str = f"{sb.RED}📥 **Behind by {data['pool_behind']}** (needs pull){sb.RESET}"
            elif data["pool_ahead"] > 0:
                if pool_sub["status"] == "pending":
                    stage1_str = f"{sb.YELLOW}⏳ **SR #{pool_sub['request_id']}** ({pool_sub['state']}){sb.RESET}"
                elif pool_sub["status"] == "accepted_pending_sync":
                    stage1_str = f"{sb.GREEN}⏳ **SR #{pool_sub['request_id']}** (accepted){sb.RESET}"
                else:
                    stage1_str = f"{sb.CYAN}📤 **Ahead by {data['pool_ahead']}** (needs submit){sb.RESET}"
            elif data["pool_status"] == "Not in Pool":
                stage1_str = f"{sb.YELLOW}❓ Not in Pool{sb.RESET}"
            elif data["pool_status"] in ("Fetch failed", "Error", "unknown"):
                stage1_str = f"{sb.RED}⚠️ {data['pool_status']}{sb.RESET}"
            elif data["pool_status"] == "In Sync":
                stage1_str = f"{sb.GREEN}✅ In Sync{sb.RESET}"
            else:
                stage1_str = f"{sb.YELLOW}❓ {data['pool_status']}{sb.RESET}"

            if data["next_status"] == "No next branch":
                stage2_str = "—"
            elif data["next_status"] in ("Comparison failed", "Error", "unknown"):
                stage2_str = f"{sb.RED}⚠️ {data['next_status']}{sb.RESET}"
            elif data["next_behind"] > 0 and data["next_ahead"] > 0:
                stage2_str = f"{sb.RED}❌ Diverged (Behind {data['next_behind']}, Ahead {data['next_ahead']}){sb.RESET}"
            elif data["next_behind"] > 0:
                stage2_str = f"{sb.RED}📥 **Behind by {data['next_behind']}** (needs merge){sb.RESET}"
            elif data["next_ahead"] > 0:
                c_s = 's' if data.get('next_ahead', 0) != 1 else ''
                stage2_str = f"{sb.GREEN}✅ In Sync (+{data['next_ahead']} next commit{c_s}){sb.RESET}"
            elif data["next_status"] in ("In Sync", "Ahead (ok)"):
                stage2_str = f"{sb.GREEN}✅ In Sync{sb.RESET}"
            else:
                stage2_str = f"{sb.YELLOW}❓ {data['next_status']}{sb.RESET}"

            actions = []
            if data["pool_behind"] > 0:
                actions.append("📥 Pull Pool")
            if data["pool_ahead"] > 0:
                if pool_sub["status"] == "pending":
                    actions.append(f"⏳ Wait for SR #{pool_sub['request_id']}")
                elif pool_sub["status"] == "accepted_pending_sync":
                    actions.append("⏳ Wait for sync")
                else:
                    actions.append("📤 Submit Pool")
            if data["next_behind"] > 0:
                actions.append("🔀 Merge next")
            action_str = " and ".join(actions) if actions else "None"

            rows.append((repo, stage1_str, stage2_str, action_str))

    has_unstable_stream = has_next_count > 0

    if has_unstable_stream:
        headers = [
            "Package",
            "Stage 1: pool ➔ devel:stable",
            "Stage 2: devel:stable ➔ devel:unstable",
            "Recommended Action"
        ]
        w1 = max(sb.visual_len(headers[0]), max(sb.visual_len(r[0]) for r in rows) if rows else 0)
        w2 = max(sb.visual_len(headers[1]), max(sb.visual_len(r[1]) for r in rows) if rows else 0)
        w3 = max(sb.visual_len(headers[2]), max(sb.visual_len(r[2]) for r in rows) if rows else 0)
        w4 = max(sb.visual_len(headers[3]), max(sb.visual_len(r[3]) for r in rows) if rows else 0)

        print(f"Total Packages: {total} | Packages with 'next' branch: {has_next_count}\n")
        print(f"### 🔄 Downstream Sync Table ({sb.BOLD}Action Required{sb.RESET})\n")
        print(f"| {sb.pad_left(headers[0], w1)} | {sb.pad_left(headers[1], w2)} | {sb.pad_left(headers[2], w3)} | {sb.pad_left(headers[3], w4)} |")
        print(f"| {'-'*w1} | {'-'*w2} | {'-'*w3} | {'-'*w4} |")

        for r in rows:
            print(f"| {sb.pad_left(r[0], w1)} | {sb.pad_left(r[1], w2)} | {sb.pad_left(r[2], w3)} | {sb.pad_left(r[3], w4)} |")
    else:
        headers = [
            "Package",
            "Central Pool Status",
            "Recommended Action"
        ]
        w1 = max(sb.visual_len(headers[0]), max(sb.visual_len(r[0]) for r in rows) if rows else 0)
        w2 = max(sb.visual_len(headers[1]), max(sb.visual_len(r[1]) for r in rows) if rows else 0)
        w3 = max(sb.visual_len(headers[2]), max(sb.visual_len(r[3]) for r in rows) if rows else 0)

        print(f"Total Packages: {total}\n")
        print(f"### 🔄 Downstream Sync Table ({sb.BOLD}Action Required{sb.RESET})\n")
        print(f"| {sb.pad_left(headers[0], w1)} | {sb.pad_left(headers[1], w2)} | {sb.pad_left(headers[2], w3)} |")
        print(f"| {'-'*w1} | {'-'*w2} | {'-'*w3} |")

        for r in rows:
            print(f"| {sb.pad_left(r[0], w1)} | {sb.pad_left(r[1], w2)} | {sb.pad_left(r[3], w3)} |")

    print(f"\n*Total packages requiring sync action: {len(rows)}*")
    if not_in_pool_count > 0 and not include_not_in_pool:
        print(f"\n💡 {sb.BOLD}Note:{sb.RESET} {not_in_pool_count} package(s) not in central Gitea pool (hidden to avoid noise; use '--include-not-in-pool' to include in table, or '--not-in-pool' for dedicated audit list).")

    if has_unstable_stream:
        print(f"\n💡 {sb.BOLD}Tip:{sb.RESET} Try 'geckopit-cli --version' to check upstream releases, or '--forward' to find forwardable next branches.")
    else:
        print(f"\n💡 {sb.BOLD}Tip:{sb.RESET} Try 'geckopit-cli --version' to check upstream releases, or '--check-pool' to audit Factory submit requests.")


def run_version_check(repos, branch=None):
    prof = sb.load_geckopit_profile_config()
    ignored_versions = prof.get("ignored_unstable_versions", {})
    total = len(repos)
    if branch:
        print(f"Checking {branch} versions for {total} packages against release-monitoring.org (30 threads)...", file=sys.stderr)
    else:
        print(f"Checking versions for {total} packages against release-monitoring.org (30 threads)...", file=sys.stderr)

    unstable_b = prof.get("unstable_branch") if prof.get("unstable_path") else None
    stable_b = prof.get("stable_branch") or "factory"

    results = {}
    with concurrent.futures.ThreadPoolExecutor(max_workers=30) as executor:
        futures = {
            executor.submit(
                sb.check_repo_version,
                repo,
                branch,
                stable_branch=stable_b,
                unstable_branch=unstable_b,
                ignored_unstable_versions=ignored_versions
            ): repo for repo in repos
        }
        completed = 0
        for future in concurrent.futures.as_completed(futures):
            repo_name, data = future.result()
            results[repo_name] = data
            completed += 1
            if completed % 25 == 0 or completed == total:
                print(f"Progress: {completed}/{total} checked...", end='\r', file=sys.stderr)
    print("", file=sys.stderr)

    has_unstable_stream = bool(
        prof.get("unstable_path") and
        any(d.get("next_ver") not in (None, "—") for d in results.values())
    )

    rows = []
    up_to_date_count = 0
    api_error_count = 0
    missing_spec_count = 0

    for repo in sorted(results.keys()):
        data = results[repo]
        if data["status"] == "error":
            missing_spec_count += 1
            continue

        if data["status"] == "partial_error":
            api_error_count += 1
            continue

        if data["needs_update"]:
            if not has_unstable_stream or branch in ("factory", "stable"):
                if sb.is_version_newer(data["upstream_stable"], data["factory_ver"], repo):
                    f_local = f"{sb.RED}{data['factory_ver']}{sb.RESET}"
                    f_up = f"{sb.GREEN}{data['upstream_stable']}{sb.RESET}"
                else:
                    f_local = f"{sb.GREEN}{data['factory_ver']}{sb.RESET}"
                    f_up = f"{sb.GREEN}{data['upstream_stable']}{sb.RESET}"
                rows.append((repo, f_local, f_up))

            elif branch in ("next", "unstable"):
                if data["next_ver"] != "—" and sb.is_version_newer(data["upstream_latest"], data["next_ver"], repo):
                    n_local = f"{sb.RED}{data['next_ver']}{sb.RESET}"
                    n_up = f"{sb.GREEN}{data['upstream_latest']}{sb.RESET}"
                else:
