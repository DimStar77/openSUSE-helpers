    print(f"  {sb.BOLD}-c, --commit{sb.RESET}       Stages packaging files, cleans whitespaces, and commits via $EDITOR.")
    print(f"  {sb.BOLD}-v, --version [b]{sb.RESET}  Compares package versions against release-monitoring.org.")
    print(f"  {sb.BOLD}-f, --forward{sb.RESET}      Identifies forwardable next branches.")
    print(f"  {sb.BOLD}--todo{sb.RESET}             Alias for default sync checking mode.")
