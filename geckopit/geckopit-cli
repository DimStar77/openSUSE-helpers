def main():
    # If invoked via git-vc (e.g. 'git vc'), gc, or gc.sh, automatically route to --commit mode
    prog_name = os.path.basename(sys.argv[0])
    if prog_name in ("git-vc", "gc", "gc.sh"):
        if "--commit" not in sys.argv and "-c" not in sys.argv:
            sys.argv.insert(1, "--commit")

    if "--bash-completion" in sys.argv:
        comp_file = os.path.join(os.path.dirname(os.path.abspath(__file__)), "completion", "geckopit.bash")
        if os.path.isfile(comp_file):
            with open(comp_file, "r", encoding="utf-8") as f:
                sys.stdout.write(f.read())
            sys.exit(0)
        else:
            print(f"Error: Completion script not found at {comp_file}", file=sys.stderr)
            sys.exit(1)
    if "--guide" in sys.argv or "--docs" in sys.argv:
        import docs_builder
        print("Opening Geckopit User Guide in default browser...")
        docs_builder.open_user_guide()
        sys.exit(0)

    if "-h" in sys.argv or "--help" in sys.argv:
        print_help()
        sys.exit(0)

    # Validate options to prevent unrecognized flags from silently falling through to default actions
    err = validate_cli_options(sys.argv[1:])
    if err:
        print(f"{sb.RED}{err}{sb.RESET}", file=sys.stderr)
        sys.exit(1)

    # Parse upgrade options first to separate version parameters from target directories
    show_upgrade = False
    upgrade_rev = None
    for idx, arg in enumerate(sys.argv):
        if arg in ("--upgrade", "-u"):
            show_upgrade = True
            if idx + 1 < len(sys.argv) and not sys.argv[idx + 1].startswith("-"):
                upgrade_rev = sys.argv[idx + 1]
        elif arg.startswith("--upgrade="):
            show_upgrade = True
            upgrade_rev = arg.split("=", 1)[1]

    # Parse merge-pr options first
    merge_pr_id = None
    for idx, arg in enumerate(sys.argv):
        if arg in ("--merge-pr",):
            if idx + 1 < len(sys.argv) and not sys.argv[idx + 1].startswith("-"):
                merge_pr_id = sys.argv[idx + 1]
        elif arg.startswith("--merge-pr="):
            merge_pr_id = arg.split("=", 1)[1]

    # Detect if a target package argument was provided (e.g. 'geckopit-cli baobab')
    target_arg = None
    for arg in sys.argv[1:]:
        if not arg.startswith("-") and arg != upgrade_rev and arg != merge_pr_id and arg not in ("factory", "next", "stable", "unstable"):
            target_arg = arg
            break

    # Determine if we are operating in Single-Package context
    target_pkg_dir = None
    if sb.is_package_dir("."):
        target_pkg_dir = "."
    elif target_arg:
        if sb.is_package_dir(target_arg):
            target_pkg_dir = target_arg
        else:
            # Check if target_arg matches a subpackage in discovered workspace packages
            discovered = sb.discover_workspace_packages('.')
            for p in discovered:
                if p == target_arg or os.path.basename(p) == target_arg:
                    target_pkg_dir = p
                    break

    # Parse sync options
    show_sync = "--sync" in sys.argv or "-s" in sys.argv or "--fetch" in sys.argv
    force_sync = "--force" in sys.argv or "-f" in sys.argv
    jobs_count = 16
    for idx, arg in enumerate(sys.argv):
        if arg in ("-j", "--jobs") and idx + 1 < len(sys.argv) and sys.argv[idx + 1].isdigit():
            jobs_count = int(sys.argv[idx + 1])
        elif arg.startswith("--jobs="):
            v = arg.split("=", 1)[1]
            if v.isdigit():
                jobs_count = int(v)

    if show_sync:
        sys.exit(run_sync_action(target_pkg_dir, force=force_sync, jobs=jobs_count))

    # Check setup / onboarding options
    if "--check-setup" in sys.argv:
        sys.exit(run_check_setup_action())
    if "--setup" in sys.argv:
        sys.exit(run_interactive_setup_action())

    # Parse fix-deps options
    show_fix_deps = "--fix-deps" in sys.argv
    if show_fix_deps:
        if not target_pkg_dir:
            print(f"{sb.RED}[Error]{sb.RESET} --fix-deps must be run inside a package directory (or target a package).", file=sys.stderr)
            sys.exit(1)
        sys.exit(run_fix_deps_action(target_pkg_dir))

    # Parse audit-deps options
    show_audit_deps = "--audit-deps" in sys.argv or "-d" in sys.argv
    if show_audit_deps:
        if not target_pkg_dir:
            print(f"{sb.RED}[Error]{sb.RESET} --audit-deps must be run inside a package directory (or target a package).", file=sys.stderr)
            sys.exit(1)
        sys.exit(run_audit_deps_action(target_pkg_dir))

    # Parse commit options
    show_commit = "--commit" in sys.argv or "-c" in sys.argv
    no_edit = "--no-edit" in sys.argv

    dry_run = "--dry-run" in sys.argv or "-n" in sys.argv

    # Execute commit mode
    if show_commit:
        if not target_pkg_dir:
            print(f"{sb.RED}[Error]{sb.RESET} --commit must be run inside a package directory (or target a package).", file=sys.stderr)
            sys.exit(1)
        sys.exit(run_package_commit(target_pkg_dir, interactive=not no_edit))

    # Execute check-patches mode
    if "--check-patches" in sys.argv:
        if not target_pkg_dir:
            print(f"{sb.RED}[Error]{sb.RESET} --check-patches must be run inside a package directory (or target a package).", file=sys.stderr)
            sys.exit(1)
        verbose = "--verbose" in sys.argv or "--sle" in sys.argv
        sys.exit(0 if patch_checker.run_check_patches_cli(target_pkg_dir, verbose=verbose) else 1)

    # Execute rebase-patch mode
    if any(arg == "--rebase-patch" or arg.startswith("--rebase-patch=") for arg in sys.argv):
        if not target_pkg_dir:
            print(f"{sb.RED}[Error]{sb.RESET} --rebase-patch must be run inside a package directory (or target a package).", file=sys.stderr)
            sys.exit(1)
        patch_arg = None
        for i, a in enumerate(sys.argv):
            if a.startswith("--rebase-patch="):
                patch_arg = a.split("=", 1)[1].strip()
            elif a == "--rebase-patch" and i + 1 < len(sys.argv) and not sys.argv[i + 1].startswith("-"):
                val = sys.argv[i + 1]
                if target_arg and val == target_arg and i + 2 < len(sys.argv) and not sys.argv[i + 2].startswith("-"):
                    patch_arg = sys.argv[i + 2]
                elif val != target_arg:
                    patch_arg = val
        shell_mode = "--shell" in sys.argv
        sle_mode = "--sle" in sys.argv
        sys.exit(0 if patch_checker.rebase_patch_cli(target_pkg_dir, patch_name=patch_arg, shell_mode=shell_mode, sle_mode=sle_mode) else 1)

    # Parse pool submission options
    custom_message = None
    for idx, arg in enumerate(sys.argv):
        if arg in ("-m", "--message"):
            if idx + 1 < len(sys.argv) and not sys.argv[idx + 1].startswith("-"):
                custom_message = sys.argv[idx + 1]
        elif arg.startswith("--message="):
            custom_message = arg.split("=", 1)[1]

    all_submit = "--all" in sys.argv or "-a" in sys.argv
    yes_arg = "--yes" in sys.argv or "-y" in sys.argv or "--no-edit" in sys.argv

    # Execute check-pool / pending-sr audit mode
    if any(arg in sys.argv for arg in ("--check-pool", "--pending-sr", "--pending-requests")):
        if target_pkg_dir:
            effective_dir, _, crossed = resolve_pool_workspace_context(target_pkg_dir=target_pkg_dir)
            if crossed:
                print(f"{sb.CYAN}ℹ️  Note: openSUSE:Factory submissions track the stable branch ('factory').{sb.RESET}", file=sys.stderr)
                print(f"   Inspecting stable checkout: {sb.BOLD}{effective_dir}{sb.RESET}", file=sys.stderr)
                print("", file=sys.stderr)
                target_pkg_dir = effective_dir
            pkg_name = os.path.basename(os.path.abspath(target_pkg_dir))
            st = pool_submit.get_package_pool_submission_status(pkg_name, target_project="openSUSE:Factory", pkg_dir=target_pkg_dir)
            print(f"── {sb.BOLD}🔍 Central Pool Status: {pkg_name}{sb.RESET} {'─'*35}")
            if st["status"] == "pending_outdated":
                r = st["request"]
                print(f"  Status:         {sb.CYAN}📤 Pending SR #{r['id']} Outdated{sb.RESET} (Newer changes detected in {r.get('source_project')}; ready to supersede)")
                print(f"  State:          {r['state']} (by @{r['creator']})")
                print(f"  Source:         {r['source_project']}/{r['source_package']}")
                print(f"  Target:         {r['target_project']}/{r['target_package']}")
                print(f"  Action:         Run 'geckopit-cli --submit-pool' to supersede with latest sources")
            elif st["status"] == "pending":
                r = st["request"]
                print(f"  Status:         {sb.YELLOW}⏳ Pending Submit Request #{r['id']}{sb.RESET} (Up-to-date with latest sources)")
                print(f"  State:          {r['state']} (by @{r['creator']})")
                print(f"  Source:         {r['source_project']}/{r['source_package']}")
                print(f"  Target:         {r['target_project']}/{r['target_package']}")
                print(f"  Description:    {r.get('description', '')}")
            elif st["status"] == "accepted_pending_sync":
                r = st["request"]
                print(f"  Status:         {sb.GREEN}⏳ Request #{r['id']} Accepted{sb.RESET}")
                print(f"  State:          accepted on {r.get('state_when', 'recently')}")
                print(f"  Target:         {r['target_project']} (awaiting sync to central pool)")
            else:
                is_osc_pkg = os.path.isdir(os.path.join(target_pkg_dir, ".osc")) and not os.path.exists(os.path.join(target_pkg_dir, ".git"))
                if is_osc_pkg:
                    src_prj = pool_submit.resolve_source_obs_project(target_pkg_dir, default="")
                    has_diff = False
                    if src_prj:
                        try:
                            rdiff = subprocess.run(["osc", "rdiff", src_prj, pkg_name, "openSUSE:Factory"], capture_output=True, text=True, timeout=10, env=pool_submit.get_obs_env())
                            if rdiff.returncode == 0 and rdiff.stdout.strip():
                                has_diff = True
                        except Exception:
                            pass
                    if has_diff:
                        print(f"  Status:         {sb.CYAN}📤 Unsubmitted{sb.RESET} (Differences detected in {src_prj}; ready for 'geckopit-cli --submit-pool')")
                    else:
                        print(f"  Status:         {sb.GREEN}✅ Up-to-date with openSUSE:Factory{sb.RESET} (no unsubmitted differences)")
                else:
                    active_br = "factory"
                    try:
                        res_br = subprocess.run(["git", "-C", target_pkg_dir, "rev-parse", "--abbrev-ref", "HEAD"], capture_output=True, text=True)
                        if res_br.returncode == 0:
                            active_br = res_br.stdout.strip()
                    except Exception:
                        pass
                    if active_br != "factory":
                        stream_info = pool_submit.check_pool_stream_sync(target_pkg_dir, branch=active_br, pkg_name=pkg_name)
                        if stream_info.get("exists"):
                            s_ahead = stream_info.get("ahead", 0)
                            s_behind = stream_info.get("behind", 0)
                            if s_ahead > 0 and s_behind > 0:
                                print(f"  Status:         {sb.RED}❌ Diverged from central pool ({active_br}) (Behind {s_behind}, Ahead {s_ahead}){sb.RESET}")
                            elif s_behind > 0:
                                print(f"  Status:         {sb.YELLOW}📥 Behind central pool ({active_br}) by {s_behind} commit{'s' if s_behind != 1 else ''} (Pull needed){sb.RESET}")
                            elif s_ahead > 0:
                                print(f"  Status:         {sb.CYAN}📤 Ahead of central pool ({active_br}) by {s_ahead} commit{'s' if s_ahead != 1 else ''} (PR needed){sb.RESET}")
                            else:
                                print(f"  Status:         {sb.GREEN}✅ Up-to-date with central pool ({active_br}){sb.RESET} (0 commits ahead)")
                        else:
                            cand_prj = pool_submit.get_git_obs_meta_project(target_pkg_dir, branch=active_br)
                            if cand_prj:
                                print(f"  Status:         {sb.CYAN}ℹ️ Checked out on '{active_br}' (configured for {cand_prj} via git-obs){sb.RESET}")
                            else:
                                print(f"  Status:         {sb.YELLOW}⚠️ Checked out on '{active_br}' (not tracked in central pool; central pool tracks 'factory'){sb.RESET}")
                    else:
                        pool_submit.ensure_pool_ref_fresh(target_pkg_dir)
                        pool_ahead = 0
                        try:
                            ahead_res = subprocess.run(["git", "-C", target_pkg_dir, "rev-list", "refs/pool/factory..origin/factory", "--count"], capture_output=True, text=True)
                            if ahead_res.returncode == 0:
                                pool_ahead = int(ahead_res.stdout.strip() or "0")
                        except Exception:
                            pass
                        if pool_ahead > 0:
                            print(f"  Status:         {sb.CYAN}📤 Unsubmitted{sb.RESET} (Ahead of pool by {pool_ahead} commit{'s' if pool_ahead != 1 else ''}; ready for 'geckopit-cli --submit-pool')")
                        else:
                            print(f"  Status:         {sb.GREEN}✅ Up-to-date with central pool{sb.RESET} (0 commits ahead)")
            sys.exit(0)
        else:
            sys.exit(run_pool_audit_cli(workspace_path=os.getcwd()))

    # Execute submit-pool mode
    if "--submit-pool" in sys.argv:
        if target_pkg_dir:
            sys.exit(run_package_pool_submit(
                target_pkg_dir,
                message=custom_message,
                dry_run=dry_run,
                force=force_sync
            ))
        else:
            if all_submit:
                sys.exit(run_all_pool_submit_cli(
                    workspace_path=os.getcwd(),
                    dry_run=dry_run,
                    yes=yes_arg,
                    force=force_sync
                ))
            else:
                sys.exit(run_pool_audit_cli(workspace_path=os.getcwd()))

    # Execute list-prs mode
    if "--list-prs" in sys.argv:
        sys.exit(0 if pr_helper.list_pull_requests(target_pkg_dir=target_pkg_dir, workspace_path=os.getcwd()) else 1)

    # Execute merge-pr mode
    if merge_pr_id:
        if not target_pkg_dir:
            print(f"{sb.RED}[Error]{sb.RESET} --merge-pr must be run inside a package directory (or target a package).", file=sys.stderr)
            sys.exit(1)
        no_commit = "--no-commit" in sys.argv
        squash = "--squash" in sys.argv
        success = pr_helper.merge_pull_request(target_pkg_dir, merge_pr_id, auto_commit=not no_commit, squash=squash)
        sys.exit(0 if success else 1)

    # Execute upgrade mode
    if show_upgrade:
        if not target_pkg_dir:
            print(f"{sb.RED}[Error]{sb.RESET} --upgrade must be run inside a package directory (or target a package).", file=sys.stderr)
            sys.exit(1)
        sys.exit(run_package_upgrade(target_pkg_dir, revision=upgrade_rev, dry_run=dry_run))

    show_versions = False
    version_branch = None

    # Check for --version or -v with equal sign, e.g. --version=next
    for arg in sys.argv:
        if arg.startswith("--version=") or arg.startswith("-v="):
            show_versions = True
            val = arg.split("=", 1)[1].lower()
            if val in ("next", "factory"):
                version_branch = val

    # Check for standalone --version or -v
    if not show_versions:
        if "--version" in sys.argv or "-v" in sys.argv:
            show_versions = True

    # Check for --branch or -b
    for opt in ("--branch", "-b"):
        if opt in sys.argv:
            idx = sys.argv.index(opt)
            if idx + 1 < len(sys.argv):
                val = sys.argv[idx + 1].lower()
                if val in ("next", "factory"):
                    version_branch = val

    # Check if 'next' or 'factory' is in sys.argv directly following -v/--version
    if show_versions and not version_branch:
        for opt in ("--version", "-v"):
            if opt in sys.argv:
                idx = sys.argv.index(opt)
                if idx + 1 < len(sys.argv):
                    val = sys.argv[idx + 1].lower()
                    if val in ("next", "factory"):
                        version_branch = val

    show_forward = "--forward" in sys.argv or "-f" in sys.argv
    show_todo = "--todo" in sys.argv
    show_no_pr = "--no-pr" in sys.argv
    show_pr = "--pr" in sys.argv or "-p" in sys.argv
    show_not_in_pool = "--not-in-pool" in sys.argv or "--no-pool" in sys.argv
    include_not_in_pool = "--include-not-in-pool" in sys.argv

    # Route to single-package dashboard if operating in a package directory
    if target_pkg_dir:
        if show_versions:
            run_single_package_version(target_pkg_dir, version_branch)
        elif show_forward:
            run_single_package_forward(target_pkg_dir, show_pr, show_no_pr)
        else:
            run_single_package_dashboard(target_pkg_dir)
        sys.stdout.flush()
        sys.stderr.flush()
        return

    # Operating in Project Directory (Multi-Package batch mode)
    repos = sb.discover_workspace_packages('.')

    if show_versions:
        run_version_check(repos, version_branch)
    elif show_forward:
        run_forward_check(repos, show_pr, show_no_pr)
    elif show_not_in_pool:
        run_not_in_pool_check(repos)
    else:
        run_sync_check(repos, include_not_in_pool=include_not_in_pool)

    sys.stdout.flush()
    sys.stderr.flush()

if __name__ == '__main__':
    try:
        main()
    except BrokenPipeError:
        import os
        os._exit(0)
