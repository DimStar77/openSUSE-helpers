#!/usr/bin/env python3
"""
openSUSE Workspace Downstream Checker CLI
CLI Frontend relying on sync_backend.py for core logic.
Supports both Project-wide multi-package batch scans and single-package focused dashboards.
"""

import os
import sys
import concurrent.futures

# Make sure we can import sync_backend from helpers/ by resolving symlinks
sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), 'helpers'))
import sync_backend as sb

def render_single_package_dashboard(data):
    repo = data['repo_name']
    wt = data['worktree']
    sync = data['sync']
    ver = data['version']
    pr = data['pr']
    branch = data['active_branch']

    print(f"{sb.BOLD}{'='*72}{sb.RESET}")
    print(f"📦 {sb.BOLD}GECKOPIT PACKAGE DASHBOARD: {sb.CYAN}{repo}{sb.RESET}")
    print(f"{sb.BOLD}{'='*72}{sb.RESET}")
    print(f"  Directory:     {data['pkg_dir']}")
    upstream_ref = wt.get('upstream') or f"origin/{branch}"
    print(f"  Checked Out:   {sb.BOLD}{branch}{sb.RESET} (tracking {upstream_ref})")
    project = ver.get('project', repo)
    print(f"  Upstream URL:  https://release-monitoring.org/project/{project}/")
    print()

    # Section 1: Local Worktree Status
    print(f"── {sb.BOLD}💻 Local Worktree Status{sb.RESET} {'─'*45}")
    ahead = wt.get('ahead', 0)
    behind = wt.get('behind', 0)
    dirty = wt.get('dirty', False)
    untracked = wt.get('untracked', False)

    if behind > 0 and ahead > 0:
        align_str = f"{sb.RED}❌ Diverged from {upstream_ref} (Behind {behind}, Ahead {ahead}){sb.RESET}"
    elif behind > 0:
        align_str = f"{sb.YELLOW}⚠️ Behind {upstream_ref} by {behind} commit{'s' if behind > 1 else ''} (Pull needed){sb.RESET}"
    elif ahead > 0:
        align_str = f"{sb.CYAN}📤 Ahead of {upstream_ref} by {ahead} commit{'s' if ahead > 1 else ''} (Unpushed){sb.RESET}"
    else:
        align_str = f"{sb.GREEN}✅ Up-to-date with {upstream_ref}{sb.RESET}"
    print(f"  Alignment:     {align_str}")

    if dirty and untracked:
        tree_str = f"{sb.YELLOW}⚠️ Dirty (uncommitted modifications + untracked files){sb.RESET}"
    elif dirty:
        tree_str = f"{sb.YELLOW}⚠️ Dirty (uncommitted modifications){sb.RESET}"
    elif untracked:
        tree_str = f"{sb.YELLOW}⚠️ Untracked files present{sb.RESET}"
    else:
        tree_str = f"{sb.GREEN}✅ Clean working directory{sb.RESET}"
    print(f"  Working Tree:  {tree_str}")
    print()

    # Section 2: Downstream SCM Sync (Gitea & Pool)
    print(f"── {sb.BOLD}🔄 Downstream SCM Sync (Gitea & Pool){sb.RESET} {'─'*32}")
    pool_behind = sync.get('pool_behind', 0)
    pool_ahead = sync.get('pool_ahead', 0)
    pool_status = sync.get('pool_status', 'unknown')
    if pool_behind > 0 and pool_ahead > 0:
        pool_str = f"{sb.RED}❌ Diverged (Behind {pool_behind}, Ahead {pool_ahead}){sb.RESET}"
    elif pool_behind > 0:
        pool_str = f"{sb.YELLOW}📥 Behind central pool by {pool_behind} commits (Pull needed){sb.RESET}"
    elif pool_ahead > 0:
        pool_str = f"{sb.CYAN}📤 Ahead of central pool by {pool_ahead} commits (Submit needed){sb.RESET}"
    elif pool_status == 'Not in Pool':
        pool_str = f"{sb.YELLOW}❓ Not in Pool{sb.RESET}"
    else:
        pool_str = f"{sb.GREEN}✅ In Sync with pool{sb.RESET}"
    print(f"  Gitea Pool:    {pool_str}")

    next_ahead = sync.get('next_ahead', 0)
    next_behind = sync.get('next_behind', 0)
    next_status = sync.get('next_status', 'unknown')
    if next_status == 'No next branch':
        fwd_str = '— (No next branch configured)'
    elif next_behind > 0 and next_ahead > 0:
        fwd_str = f"{sb.RED}❌ Diverged (Behind {next_behind}, Ahead {next_ahead}){sb.RESET}"
    elif next_behind > 0:
        fwd_str = f"{sb.YELLOW}⚠️ Behind factory by {next_behind} commits (Catch-up merge needed){sb.RESET}"
    elif next_ahead > 0:
        fwd_str = f"{sb.GREEN}🔀 Ahead of factory by {next_ahead} commits (Ready to forward){sb.RESET}"
    else:
        fwd_str = f"{sb.GREEN}✅ In Sync (no unforwarded next commits){sb.RESET}"
    print(f"  Branch Sync:   {fwd_str}")

    if pr.get('has_pr', False):
        pr_str = f"{sb.GREEN}🟢 PR #{pr.get('number')}: {pr.get('url')}{sb.RESET}"
    else:
        pr_str = "None (no active PR)"
    print(f"  Active PR:     {pr_str}")
    print()

    # Section 3: Upstream Release Versions
    print(f"── {sb.BOLD}📦 Upstream Release Versions{sb.RESET} {'─'*41}")
    f_ver = ver.get('factory_ver', 'N/A')
    u_stable = ver.get('upstream_stable', 'N/A')
    n_ver = ver.get('next_ver', '—')
    u_latest = ver.get('upstream_latest', '—')

    if sb.is_version_newer(u_stable, f_ver, repo):
        f_status = f"{sb.YELLOW}🔺 Update available: {f_ver} ➔ {u_stable}{sb.RESET}"
    else:
        f_status = f"{sb.GREEN}✅ Up-to-date ({f_ver}){sb.RESET}"
    print(f"  Factory:       {f_status}")

    if n_ver != '—':
        if sb.is_version_newer(u_latest, n_ver, repo):
            n_status = f"{sb.YELLOW}🔺 Update available: {n_ver} ➔ {u_latest}{sb.RESET}"
        else:
            n_status = f"{sb.GREEN}✅ Up-to-date ({n_ver}){sb.RESET}"
        print(f"  Next:          {n_status}")
    print()

    # Section 4: Recommended Actions
    actions = []
    if behind > 0:
        actions.append(f"📥 Pull remote commits: {sb.BOLD}git pull --ff-only{sb.RESET}")
    if pool_behind > 0:
        actions.append(f"📥 Pull upstream changes from Pool: {sb.BOLD}git fetch https://src.opensuse.org/pool/{repo}.git factory && git merge FETCH_HEAD{sb.RESET}")
    if next_behind > 0:
        actions.append(f"🔀 Catch-up merge from factory: {sb.BOLD}git merge origin/factory{sb.RESET}")
    if next_ahead > 0 and not pr.get('has_pr'):
        actions.append(f"📤 Create Gitea Pull Request from {branch} to factory")
    if ver.get('needs_update'):
        target_v = u_latest if branch == 'next' and u_latest != '—' else u_stable
        actions.append(f"⚙️  Run upgrade helper: {sb.BOLD}geckopit-upgrade {target_v}{sb.RESET}")

    print(f"── {sb.BOLD}💡 Recommended Actions{sb.RESET} {'─'*46}")
    if actions:
        for a in actions:
            print(f"  • {a}")
    else:
        print(f"  {sb.GREEN}✅ Package is fully in sync and up-to-date. No action needed!{sb.RESET}")
    print(f"{sb.BOLD}{'='*72}{sb.RESET}")


def run_single_package_dashboard(pkg_dir="."):
    pkg_name = sb.get_package_name_from_dir(pkg_dir)
    print(f"Inspecting package '{pkg_name}'...", file=sys.stderr)
    data = sb.check_single_package_full(pkg_dir)
    render_single_package_dashboard(data)


def run_single_package_version(pkg_dir=".", branch=None):
    pkg_name = sb.get_package_name_from_dir(pkg_dir)
    print(f"Checking upstream versions for '{pkg_name}'...", file=sys.stderr)
    parent_dir = os.path.dirname(os.path.abspath(pkg_dir))
    prof = sb.load_geckopit_profile_config()
    st_b = prof.get("stable_branch", "factory") or "factory"
    unst_b = prof.get("unstable_branch", "next") or "next"
    ignored = prof.get("ignored_unstable_versions", {})

    _, data = sb.check_repo_version(pkg_name, branch, st_b, unst_b, parent_dir, ignored)
    print(f"\n📦 {sb.BOLD}Package Upstream Version: {sb.CYAN}{pkg_name}{sb.RESET}")
    print(f"{sb.BOLD}{'='*60}{sb.RESET}")
    f_ver = data.get("factory_ver", "N/A")
    u_stable = data.get("upstream_stable", "N/A")
    n_ver = data.get("next_ver", "—")
    u_latest = data.get("upstream_latest", "—")

    if not branch or branch == "factory":
        if sb.is_version_newer(u_stable, f_ver, pkg_name):
            status = f"{sb.YELLOW}🔺 Update available: {f_ver} ➔ {u_stable}{sb.RESET}"
        else:
            status = f"{sb.GREEN}✅ Up-to-date ({f_ver}){sb.RESET}"
        print(f"  Factory Branch: {status}")

    if not branch or branch == "next":
        if n_ver != "—":
            if sb.is_version_newer(u_latest, n_ver, pkg_name):
                status = f"{sb.YELLOW}🔺 Update available: {n_ver} ➔ {u_latest}{sb.RESET}"
            else:
                status = f"{sb.GREEN}✅ Up-to-date ({n_ver}){sb.RESET}"
            print(f"  Next Branch:    {status}")
    print(f"{sb.BOLD}{'='*60}{sb.RESET}")


def run_single_package_forward(pkg_dir=".", show_pr=False, only_no_pr=False):
    pkg_name = sb.get_package_name_from_dir(pkg_dir)
    print(f"Checking forwarding status for '{pkg_name}'...", file=sys.stderr)
    parent_dir = os.path.dirname(os.path.abspath(pkg_dir))
    prof = sb.load_geckopit_profile_config()
    st_b = prof.get("stable_branch", "factory") or "factory"
    unst_b = prof.get("unstable_branch", "next") or "next"

    _, sync = sb.check_repo_sync(pkg_name, st_b, unst_b, parent_dir)
    _, pr = sb.check_repo_pr(pkg_name, st_b, unst_b, parent_dir)

    print(f"\n🔀 {sb.BOLD}Package Forwarding State: {sb.CYAN}{pkg_name}{sb.RESET}")
    print(f"{sb.BOLD}{'='*60}{sb.RESET}")
    next_ahead = sync.get("next_ahead", 0)
    next_behind = sync.get("next_behind", 0)

    print(f"  Commits Ahead (on next):    {sb.GREEN}{next_ahead}{sb.RESET}")
    print(f"  Commits Behind (factory):   {sb.RED if next_behind > 0 else sb.GREEN}{next_behind}{sb.RESET}")

    if next_behind > 0:
        fwd = f"{sb.YELLOW}⚠️ Needs Catch-up Merge first{sb.RESET}"
    elif next_ahead > 0:
        fwd = f"{sb.GREEN}✅ Ready to Forward (Clean){sb.RESET}"
    else:
        fwd = f"{sb.GREEN}✅ In Sync{sb.RESET}"
    print(f"  Forward Status:             {fwd}")

    if pr.get("has_pr"):
        pr_str = f"{sb.GREEN}Yes (PR #{pr.get('number')}) - {pr.get('url')}{sb.RESET}"
    else:
        pr_str = f"{sb.RED}No{sb.RESET}"
    print(f"  PR Pending:                 {pr_str}")
    print(f"{sb.BOLD}{'='*60}{sb.RESET}")


def run_sync_check(repos):
    total = len(repos)
    print(f"Checking {total} packages in parallel (50 threads)...", file=sys.stderr)

    results = {}
    with concurrent.futures.ThreadPoolExecutor(max_workers=50) as executor:
        futures = {executor.submit(sb.check_repo_sync, repo): repo for repo in repos}
        completed = 0
        for future in concurrent.futures.as_completed(futures):
            repo_name, data = future.result()
            results[repo_name] = data
            completed += 1
            if completed % 50 == 0 or completed == total:
                print(f"Progress: {completed}/{total} checked...", end='\r', file=sys.stderr)
    print("", file=sys.stderr)

    has_next_count = sum(1 for r, d in results.items() if d.get("status") == "success" and d.get("next_status") != "No next branch")

    rows = []
    for repo in sorted(results.keys()):
        data = results[repo]
        if data["status"] != "success":
            continue
        if data["needs_action"]:
            # Stage 1 format
            if data["pool_behind"] > 0 and data["pool_ahead"] > 0:
                stage1_str = f"{sb.RED}❌ Diverged (Behind {data['pool_behind']}, Ahead {data['pool_ahead']}){sb.RESET}"
            elif data["pool_behind"] > 0:
                stage1_str = f"{sb.RED}📥 **Behind by {data['pool_behind']}** (needs pull){sb.RESET}"
            elif data["pool_ahead"] > 0:
                stage1_str = f"{sb.CYAN}📤 **Ahead by {data['pool_ahead']}** (needs submit){sb.RESET}"
            elif data["pool_status"] == "Not in Pool":
                stage1_str = f"{sb.YELLOW}❓ Not in Pool{sb.RESET}"
            else:
                stage1_str = f"{sb.GREEN}✅ In Sync{sb.RESET}"

            # Stage 2 format
            if data["next_status"] == "No next branch":
                stage2_str = "—"
            elif data["next_behind"] > 0 and data["next_ahead"] > 0:
                stage2_str = f"{sb.RED}❌ Diverged (Behind {data['next_behind']}, Ahead {data['next_ahead']}){sb.RESET}"
            elif data["next_behind"] > 0:
                stage2_str = f"{sb.RED}📥 **Behind by {data['next_behind']}** (needs merge){sb.RESET}"
            elif data["next_ahead"] > 0:
                stage2_str = f"{sb.GREEN}✅ In Sync (+{data['next_ahead']} next commits){sb.RESET}"
            else:
                stage2_str = f"{sb.GREEN}✅ In Sync{sb.RESET}"

            # Recommended Actions
            actions = []
            if data["pool_behind"] > 0:
                actions.append("📥 Pull Pool")
            if data["pool_ahead"] > 0:
                actions.append("📤 Submit Pool")
            if data["next_behind"] > 0:
                actions.append("🔀 Merge next")
            action_str = " and ".join(actions) if actions else "None"

            rows.append((repo, stage1_str, stage2_str, action_str))

    headers = [
        "Package",
        "Stage 1: pool ➔ devel:factory",
        "Stage 2: devel:factory ➔ devel:next",
        "Recommended Action"
    ]

    w1 = max(sb.visual_len(headers[0]), max(sb.visual_len(r[0]) for r in rows) if rows else 0)
    w2 = max(sb.visual_len(headers[1]), max(sb.visual_len(r[1]) for r in rows) if rows else 0)
    w3 = max(sb.visual_len(headers[2]), max(sb.visual_len(r[2]) for r in rows) if rows else 0)
    w4 = max(sb.visual_len(headers[3]), max(sb.visual_len(r[3]) for r in rows) if rows else 0)

    print(f"Total Packages: {total} | Packages with 'next' branch: {has_next_count}\n")
    print(f"### 🔄 Downstream Sync Table ({sb.BOLD}Action Required{sb.RESET})\n")
    print(f"| {sb.pad_left(headers[0], w1)} | {sb.pad_left(headers[1], w2)} | {sb.pad_left(headers[2], w3)} | {sb.pad_left(headers[3], w4)} |")
    print(f"| {'-'*w1} | {'-'*w2} | {'-'*w3} | {'-'*w4} |")

    for r in rows:
        print(f"| {sb.pad_left(r[0], w1)} | {sb.pad_left(r[1], w2)} | {sb.pad_left(r[2], w3)} | {sb.pad_left(r[3], w4)} |")

    print(f"\n*Total packages requiring sync action: {len(rows)}*")
    print(f"\n💡 {sb.BOLD}Tip:{sb.RESET} Try './geckopit-cli --version' to check upstream releases, or '--forward' to find forwardable next branches.")


def run_version_check(repos, branch=None):
    prof = sb.load_geckopit_profile_config()
    ignored_versions = prof.get("ignored_unstable_versions", {})
    total = len(repos)
    if branch:
        print(f"Checking {branch} versions for {total} packages against release-monitoring.org (30 threads)...", file=sys.stderr)
    else:
        print(f"Checking versions for {total} packages against release-monitoring.org (30 threads)...", file=sys.stderr)

    results = {}
    with concurrent.futures.ThreadPoolExecutor(max_workers=30) as executor:
        futures = {executor.submit(sb.check_repo_version, repo, branch, ignored_unstable_versions=ignored_versions): repo for repo in repos}
        completed = 0
        for future in concurrent.futures.as_completed(futures):
            repo_name, data = future.result()
            results[repo_name] = data
            completed += 1
            if completed % 25 == 0 or completed == total:
                print(f"Progress: {completed}/{total} checked...", end='\r', file=sys.stderr)
    print("", file=sys.stderr)

    rows = []
    up_to_date_count = 0
    api_error_count = 0
    missing_spec_count = 0

    for repo in sorted(results.keys()):
        data = results[repo]
        if data["status"] == "error":
            missing_spec_count += 1
            continue

        if data["status"] == "partial_error":
            api_error_count += 1
            continue

        if data["needs_update"]:
            if branch == "factory":
                if sb.is_version_newer(data["upstream_stable"], data["factory_ver"], repo):
                    f_local = f"{sb.RED}{data['factory_ver']}{sb.RESET}"
                    f_up = f"{sb.GREEN}{data['upstream_stable']}{sb.RESET}"
                else:
                    f_local = f"{sb.GREEN}{data['factory_ver']}{sb.RESET}"
                    f_up = f"{sb.GREEN}{data['upstream_stable']}{sb.RESET}"
                rows.append((repo, f_local, f_up))

            elif branch == "next":
                if data["next_ver"] != "—" and sb.is_version_newer(data["upstream_latest"], data["next_ver"], repo):
                    n_local = f"{sb.RED}{data['next_ver']}{sb.RESET}"
                    n_up = f"{sb.GREEN}{data['upstream_latest']}{sb.RESET}"
                else:
                    n_local = f"{sb.GREEN}{data['next_ver']}{sb.RESET}" if data["next_ver"] != "—" else "—"
                    n_up = f"{sb.GREEN}{data['upstream_latest']}{sb.RESET}" if data["upstream_latest"] != "—" else "—"
                rows.append((repo, n_local, n_up))

            else:
                if sb.is_version_newer(data["upstream_stable"], data["factory_ver"], repo):
                    f_local = f"{sb.RED}{data['factory_ver']}{sb.RESET}"
                    f_up = f"{sb.GREEN}{data['upstream_stable']}{sb.RESET}"
                else:
                    f_local = f"{sb.GREEN}{data['factory_ver']}{sb.RESET}"
                    f_up = f"{sb.GREEN}{data['upstream_stable']}{sb.RESET}"

                if data["next_ver"] != "—" and sb.is_version_newer(data["upstream_latest"], data["next_ver"], repo):
                    n_local = f"{sb.RED}{data['next_ver']}{sb.RESET}"
                    n_up = f"{sb.GREEN}{data['upstream_latest']}{sb.RESET}"
                else:
                    n_local = f"{sb.GREEN}{data['next_ver']}{sb.RESET}" if data["next_ver"] != "—" else "—"
                    n_up = f"{sb.GREEN}{data['upstream_latest']}{sb.RESET}" if data["upstream_latest"] != "—" else "—"

                rows.append((
                    repo,
                    f_local,
                    f_up,
                    n_local,
                    n_up
                ))
        else:
            up_to_date_count += 1

    if branch == "factory":
        headers = [
            "Package",
            "Local (factory)",
            "Upstream (stable)"
        ]
    elif branch == "next":
        headers = [
            "Package",
            "Local (next)",
            "Upstream (unstable)"
        ]
    else:
        headers = [
            "Package",
            "Local (factory)",
            "Upstream (stable)",
            "Local (next)",
            "Upstream (unstable)"
        ]

    widths = []
    for i, h in enumerate(headers):
        w = max(sb.visual_len(h), max(sb.visual_len(r[i]) for r in rows) if rows else 0)
        widths.append(w)

    print(f"Total Checked: {total} | Up to date: {up_to_date_count} | API errors: {api_error_count} | Missing specs: {missing_spec_count}\n")
    title_branch = f" ({branch})" if branch else ""
    print(f"### 📦 Upstream Version Sync Table{title_branch} ({sb.BOLD}Updates Available{sb.RESET})\n")

    header_str = " | ".join(sb.pad_left(headers[i], widths[i]) for i in range(len(headers)))
    sep_str = " | ".join('-'*widths[i] for i in range(len(headers)))
    print(f"| {header_str} |")
    print(f"| {sep_str} |")

    for r in rows:
        row_str = " | ".join(sb.pad_left(r[i], widths[i]) for i in range(len(headers)))
        print(f"| {row_str} |")

    print(f"\n*Total packages that could use an update: {len(rows)}*")


def run_forward_check(repos, show_pr=False, only_no_pr=False):
    total = len(repos)
    print(f"Checking {total} packages for forwardable next branches (50 threads)...", file=sys.stderr)

    results = {}
    with concurrent.futures.ThreadPoolExecutor(max_workers=50) as executor:
        futures = {executor.submit(sb.check_repo_sync, repo): repo for repo in repos}
        completed = 0
        for future in concurrent.futures.as_completed(futures):
            repo_name, data = future.result()
            results[repo_name] = data
            completed += 1
            if completed % 50 == 0 or completed == total:
                print(f"Progress: {completed}/{total} checked...", end='\r', file=sys.stderr)
    print("", file=sys.stderr)

    forward_candidates = []
    for repo in sorted(results.keys()):
        data = results[repo]
        if data["status"] != "success":
            continue
        if data["next_status"] != "No next branch" and data["next_status"] != "N/A":
            next_ahead = data["next_ahead"]
            if next_ahead > 0:
                forward_candidates.append(repo)

    pr_status = {}
    if (show_pr or only_no_pr) and forward_candidates:
        print(f"Checking Gitea pull requests for {len(forward_candidates)} candidates (20 threads)...", file=sys.stderr)
        with concurrent.futures.ThreadPoolExecutor(max_workers=20) as executor:
            pr_futures = {executor.submit(sb.check_repo_pr, repo): repo for repo in forward_candidates}
            completed_prs = 0
            for future in concurrent.futures.as_completed(pr_futures):
                repo_name, pr_data = future.result()
                pr_status[repo_name] = pr_data
                completed_prs += 1
                if completed_prs % 10 == 0 or completed_prs == len(forward_candidates):
                    print(f"PR Progress: {completed_prs}/{len(forward_candidates)} checked...", end='\r', file=sys.stderr)
        print("", file=sys.stderr)

    rows = []
    ready_count = 0
    needs_merge_count = 0

    for repo in sorted(results.keys()):
        data = results[repo]
        if data["status"] != "success":
            continue
        if data["next_status"] != "No next branch" and data["next_status"] != "N/A":
            next_ahead = data["next_ahead"]
            next_behind = data["next_behind"]

            if next_ahead > 0:
                pr_info = pr_status.get(repo, {"has_pr": False, "url": None, "number": None})
                if only_no_pr and pr_info["has_pr"]:
                    continue

                if next_behind == 0:
                    status_str = f"{sb.GREEN}✅ Ready (Clean Forward){sb.RESET}"
                    ready_count += 1
                else:
                    status_str = f"{sb.YELLOW}⚠️ Needs Merge first (Behind {next_behind}){sb.RESET}"
                    needs_merge_count += 1

                if show_pr or only_no_pr:
                    if pr_info["has_pr"]:
                        pr_display = f"{sb.GREEN}Yes (PR #{pr_info['number']}){sb.RESET}"
                    else:
                        pr_display = f"{sb.RED}No{sb.RESET}"

                    rows.append((
                        repo,
                        f"{sb.GREEN}{next_ahead}{sb.RESET}",
                        f"{sb.RED}{next_behind}{sb.RESET}" if next_behind > 0 else f"{sb.GREEN}0{sb.RESET}",
                        status_str,
                        pr_display
                    ))
                else:
                    rows.append((
                        repo,
                        f"{sb.GREEN}{next_ahead}{sb.RESET}",
                        f"{sb.RED}{next_behind}{sb.RESET}" if next_behind > 0 else f"{sb.GREEN}0{sb.RESET}",
                        status_str
                    ))

    if show_pr or only_no_pr:
        headers = [
            "Package",
            "Commits Ahead (on next)",
            "Commits Behind (from factory)",
            "Forward Status",
            "PR Pending?"
        ]
    else:
        headers = [
            "Package",
            "Commits Ahead (on next)",
            "Commits Behind (from factory)",
            "Forward Status"
        ]

    widths = []
    for i, h in enumerate(headers):
        w = max(sb.visual_len(h), max(sb.visual_len(r[i]) for r in rows) if rows else 0)
        widths.append(w)

    print(f"Total Packages: {total} | Ready to Forward: {ready_count} | Needs Merge: {needs_merge_count}\n")
    print(f"### 🔀 Next-to-Factory Forwarding Table\n")

    header_str = " | ".join(sb.pad_left(headers[i], widths[i]) for i in range(len(headers)))
    sep_str = " | ".join('-'*widths[i] for i in range(len(headers)))
    print(f"| {header_str} |")
    print(f"| {sep_str} |")

    for r in rows:
        row_str = " | ".join(sb.pad_left(r[i], widths[i]) for i in range(len(headers)))
        print(f"| {row_str} |")

    print(f"\n*Total packages displayed: {len(rows)}*")


def print_help():
    print(f"{sb.BOLD}openSUSE Workspace Downstream Checker{sb.RESET}")
    print("\nAn optimized parallel dashboard for openSUSE package maintainers.")
    print("Supports both Project meta-checkouts and single-package directories.")
