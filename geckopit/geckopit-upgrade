#!/usr/bin/env python3
"""
Geckopit Package Upgrade Helper CLI.
Can be executed directly from a package checkout directory or within Geckopit.
"""

import argparse
import os
import sys

# Add helpers directory to Python module search path
SCRIPT_DIR = os.path.dirname(os.path.realpath(__file__))
HELPERS_DIR = os.path.join(SCRIPT_DIR, "helpers")
if HELPERS_DIR not in sys.path:
    sys.path.insert(0, HELPERS_DIR)

from upgrade import get_upgrade_helper, list_upgrade_helpers

def main():
    parser = argparse.ArgumentParser(
        prog="geckopit-upgrade",
        description="Geckopit Universal Package Upgrade Helper",
        epilog="Examples:\n"
               "  geckopit-upgrade                 # Upgrade to @PARENT_TAG@\n"
               "  geckopit-upgrade 1.19.0          # Upgrade to tag/version 1.19.0\n"
               "  geckopit-upgrade --dir ../baobab # Upgrade specified directory\n"
               "  geckopit-upgrade --dry-run       # Test detection without writing"
    )
    parser.add_argument(
        "revision",
        nargs="?",
        default=None,
        help="Target revision, tag, branch, or commit SHA (default: @PARENT_TAG@)"
    )
    parser.add_argument(
        "-d", "--dir",
        default=".",
        help="Path to package directory (default: current directory)"
    )
    parser.add_argument(
        "-n", "--dry-run",
        action="store_true",
        help="Simulate the upgrade process without making changes"
    )
    parser.add_argument(
        "--helper",
        default=None,
        help="Force a specific upgrade helper engine (e.g. obs_scm)"
    )
    parser.add_argument(
        "--list-helpers",
        action="store_true",
        help="List available upgrade helper engines and exit"
    )

    args = parser.parse_args()

    if args.list_helpers:
        print("\033[1mRegistered Geckopit Upgrade Engines:\033[0m")
        for h in list_upgrade_helpers():
            print(f"  • \033[1;32m{h.name:12}\033[0m : {h.description}")
        return 0

    pkg_dir = os.path.abspath(args.dir)
    if not os.path.isdir(pkg_dir):
        print(f"\033[1;31m[Error]\033[0m Specified directory does not exist: {pkg_dir}", file=sys.stderr)
        return 1

    helper = get_upgrade_helper(pkg_dir, helper_name=args.helper)
    if not helper:
        print(f"\033[1;31m[Error]\033[0m No compatible upgrade helper detected for directory: {pkg_dir}", file=sys.stderr)
        print("Available engines:")
        for h in list_upgrade_helpers():
            print(f"  • {h.name} - {h.description}")
        return 1

    pkg_basename = os.path.basename(pkg_dir)
    rev_display = args.revision if args.revision else "@PARENT_TAG@ (default)"

    print(f"\033[1;34m=>\033[0m \033[1mGeckopit Package Upgrade\033[0m: \033[1;37m{pkg_basename}\033[0m")
    print(f"\033[1;34m=>\033[0m Engine: \033[1;32m{helper.name}\033[0m ({helper.description})")
    print(f"\033[1;34m=>\033[0m Target Revision: \033[1;33m{rev_display}\033[0m")
    if args.dry_run:
        print("\033[1;33m=> Mode: DRY-RUN (no files will be modified)\033[0m")

    def log_callback(msg: str):
        print(f"   \033[0;37m{msg}\033[0m")

    result = helper.execute_upgrade(
        target_revision=args.revision,
        dry_run=args.dry_run,
        on_log=log_callback
    )

    print()
    if result.success:
        print(f"\033[1;32m=> Upgrade Succeeded:\033[0m {result.message}")
        if result.diff_files:
            print("   \033[1mReview files generated:\033[0m")
            for df in result.diff_files.keys():
                print(f"     • {df}")
        return 0
    else:
        print(f"\033[1;31m=> Upgrade Failed:\033[0m {result.message}", file=sys.stderr)
        return 1

if __name__ == "__main__":
    sys.exit(main())
